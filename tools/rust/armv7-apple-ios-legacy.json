{
  "abi-return-struct-as-int": true,
  "arch": "arm",
  "archive-format": "darwin",
  "binary-format": "mach-o",
  "cpu": "cortex-a8",
  "crt-objects-fallback": "false",
  "data-layout": "e-m:o-p:32:32-Fi8-f64:32:64-v64:32:64-v128:32:128-a:0:32-n32-S32",
  "debuginfo-kind": "dwarf-dsym",
  "dll-suffix": ".dylib",
  "dynamic-linking": true,
  "eh-frame-header": false,
  "emit-debug-gdb-scripts": false,
  "features": "+v7,+vfp3,+neon,+d32",
  "frame-pointer": "always",
  "function-sections": false,
  "has-rpath": true,
  "has-thread-local": false,
  "is-like-darwin": true,
  "link-env": [
    "ZERO_AR_DATE=1"
  ],
  "link-env-remove": [
    "MACOSX_DEPLOYMENT_TARGET"
  ],
  "linker-flavor": "darwin-cc",
  "linker-is-gnu": false,
  "lld-flavor": "darwin",
  "llvm-floatabi": "hard",
  "llvm-target": "armv7-apple-ios",
  "max-atomic-width": 64,
  "metadata": {
    "description": "ARMv7-A Apple iOS 4-7 (A4-A6), LegacyFox",
    "host_tools": false,
    "std": true,
    "tier": 3
  },
  "os": "ios",
  "split-debuginfo": "packed",
  "supported-split-debuginfo": [
    "packed",
    "unpacked",
    "off"
  ],
  "target-family": [
    "unix"
  ],
  "target-pointer-width": 32,
  "vendor": "apple"
}
