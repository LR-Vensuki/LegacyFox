From 853f17ce73373de9e3ec9fe996649c17d88745c4 Mon Sep 17 00:00:00 2001
From: LR-Vensuki <260785366+LR-Vensuki@users.noreply.github.com>
Date: Thu, 8 Oct 2026 01:01:31 +0300
Subject: [PATCH 06/42] armv7 iOS: MOZ_IOS_LEGACY; code for iOS 9
 (thread_local), no GNU/ELF assembly in pixman/libvpx/opus/ffvpx, no ARMv8
 crypto in NSS, no llama.cpp

---
 build/moz.configure/init.configure             | 13 +++++++++++++
 build/moz.configure/toolchain.configure        |  8 +++++++-
 dom/webidl/moz.build                           |  2 +-
 gfx/cairo/libpixman/src/moz.build              |  3 ++-
 media/ffvpx/config.h                           |  3 +++
 media/libopus/moz.build                        |  4 ++--
 media/libvpx/moz.build                         |  4 +++-
 security/moz.build                             |  6 ++++++
 toolkit/components/ml/backends/llama/moz.build |  2 +-
 toolkit/components/ml/moz.build                |  2 +-
 toolkit/moz.configure                          | 15 ++++++++++++---
 11 files changed, 51 insertions(+), 11 deletions(-)

diff --git a/build/moz.configure/init.configure b/build/moz.configure/init.configure
index 833904ff91..413cb164fe 100644
--- a/build/moz.configure/init.configure
+++ b/build/moz.configure/init.configure
@@ -900,6 +900,19 @@ def target_is_ios(target):
 set_define("XP_IOS", target_is_ios)
 
 
+# LegacyFox: iOS 4-7 on armv7, built against the iOS 6.1 SDK. Everything the
+# iOS port takes from iOS 17 (BrowserEngineKit, ExtensionKit, XPC, IOSurface,
+# VideoToolbox, Swift) is left out where this is set.
+@depends(target)
+def target_is_ios_legacy(target):
+    if target.os == "iOS" and target.cpu == "arm":
+        return True
+
+
+set_config("MOZ_IOS_LEGACY", target_is_ios_legacy)
+set_define("MOZ_IOS_LEGACY", target_is_ios_legacy)
+
+
 @depends(target)
 def target_has_linux_kernel(target):
     if target.kernel == "Linux":
diff --git a/build/moz.configure/toolchain.configure b/build/moz.configure/toolchain.configure
index 9148e9bf9e..4f8642f5ff 100644
--- a/build/moz.configure/toolchain.configure
+++ b/build/moz.configure/toolchain.configure
@@ -1374,7 +1374,13 @@ def compiler(
         if host_or_target.os == "OSX" and macos_target:
             flags.append("-mmacosx-version-min=%s" % macos_target)
         if host_or_target.os == "iOS" and ios_target:
-            flags.append("-mios-version-min=%s" % ios_target)
+            # LegacyFox: clang allows thread_local on armv7 only from iOS 9,
+            # so code is generated for 9 there (with -femulated-tls, which
+            # works on any iOS) and the iOS 4+ minimum is set at link time.
+            if host_or_target.cpu == "arm" and Version(ios_target) < Version("9.0"):
+                flags.append("-mios-version-min=9.0")
+            else:
+                flags.append("-mios-version-min=%s" % ios_target)
 
         # When not given an explicit compatibility version, clang-cl tries
         # to get one from MSVC, which might not even be the one used by the
diff --git a/dom/webidl/moz.build b/dom/webidl/moz.build
index 35be78b5ef..8ffbcb0202 100644
