         'pixman-arma64-neon-asm.S',
     ]
     SOURCES['pixman-arm-neon.c'].flags += ['-march=armv8-a']
-elif CONFIG['TARGET_CPU'] == 'arm':
+# LegacyFox: pixman's ARM assembly is GNU/ELF only; armv7 iOS takes the C paths.
+elif CONFIG['TARGET_CPU'] == 'arm' and not CONFIG['MOZ_IOS_LEGACY']:
     if CONFIG['HAVE_ARM_NEON']:
         DEFINES['USE_ARM_NEON'] = True
         SOURCES += [
