diff --git a/mobile/shared/modules/geckoview/LegacyFoxLogins.sys.mjs b/mobile/shared/modules/geckoview/LegacyFoxLogins.sys.mjs
new file mode 100644
index 0000000000..a103caf26e
--- /dev/null
+++ b/mobile/shared/modules/geckoview/LegacyFoxLogins.sys.mjs
@@ -0,0 +1,50 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// LegacyFox: the saved passwords screen of the iOS 4-7 shell reads and
+// removes logins in Gecko's own store through these runtime events.
+
+import { GeckoViewUtils } from "resource://gre/modules/GeckoViewUtils.sys.mjs";
+
+const { warn } = GeckoViewUtils.initLogging("LegacyFoxLogins");
+
+export const LegacyFoxLogins = {
+  async onEvent(aEvent, aData, aCallback) {
+    try {
+      switch (aEvent) {
+        case "LegacyFox:Logins:Get": {
+          const logins = await Services.logins.getAllLogins();
+          aCallback.onSuccess(
+            logins.map(l => ({
+              guid: l.guid,
+              origin: l.origin,
+              username: l.username,
+              password: l.password,
+            }))
+          );
+          break;
+        }
+        case "LegacyFox:Logins:Add": {
+          const login = Cc["@mozilla.org/login-manager/loginInfo;1"].createInstance(Ci.nsILoginInfo);
+          login.init(aData.origin, aData.origin, null, aData.username ?? "", aData.password, "", "");
+          const added = await Services.logins.addLoginAsync(login);
+          aCallback.onSuccess(added.guid);
+          break;
+        }
+        case "LegacyFox:Logins:Remove": {
+          const logins = await Services.logins.getAllLogins();
+          const login = logins.find(l => l.guid == aData.guid);
+          if (login) {
+            Services.logins.removeLogin(login);
+          }
+          aCallback.onSuccess(!!login);
+          break;
+        }
+      }
+    } catch (e) {
+      warn`${aEvent}: ${e}`;
+      aCallback.onError(String(e));
+    }
+  },
+};
