 import { GeckoViewUtils } from "resource://gre/modules/GeckoViewUtils.sys.mjs";
+import { AppConstants } from "resource://gre/modules/AppConstants.sys.mjs";
 
 const lazy = {};
 
@@ -21,6 +22,28 @@ const LoginStorageHint = {
   LOW_CONFIDENCE: 1 << 1,
 };
 
+// On iOS the logins live in Gecko's own store (logins.json, encrypted with
+// the NSS key in key4.db) rather than in the embedding app, as on desktop:
+// autofill reads that store, and Sync's passwords engine works on it.
+async function saveInGecko(selectedLogin, oldGuid) {
+  const login = lazy.LoginEntry.parse(selectedLogin).toLoginInfo();
+  const all = oldGuid ? await Services.logins.getAllLogins() : [];
+  const existing = all.find(l => l.guid == oldGuid);
+  if (existing) {
+    Services.logins.modifyLogin(existing, login);
+  } else {
+    await Services.logins.addLoginAsync(login);
+  }
+}
+
+function storeLogin(selectedLogin, oldGuid = null) {
+  if (AppConstants.platform == "ios") {
+    saveInGecko(selectedLogin, oldGuid).catch(e => warn`saving a login: ${e}`);
+  } else {
+    lazy.GeckoViewAutocomplete.onLoginSave(selectedLogin);
+  }
+}
+
