From 898b88b8dae3e286379b29fa2bc470e6ab43afb2 Mon Sep 17 00:00:00 2001
From: LR-Vensuki <260785366+LR-Vensuki@users.noreply.github.com>
Date: Wed, 14 Oct 2026 22:54:34 +0300
Subject: [PATCH 36/42] AppleVTDecoder on iOS 4-7: NV12 output, the format the
 hardware decoder gives there

---
 dom/media/platforms/apple/AppleVTDecoder.cpp | 51 ++++++++++++++------
 1 file changed, 37 insertions(+), 14 deletions(-)

diff --git a/dom/media/platforms/apple/AppleVTDecoder.cpp b/dom/media/platforms/apple/AppleVTDecoder.cpp
index 79c31a5ce1..2aa1cf8812 100644
--- a/dom/media/platforms/apple/AppleVTDecoder.cpp
+++ b/dom/media/platforms/apple/AppleVTDecoder.cpp
@@ -474,20 +474,38 @@ void AppleVTDecoder::OutputFrame(CVPixelBufferRef aImage,
     buffer.mPlanes[0].mWidth = width;
     buffer.mPlanes[0].mHeight = height;
     buffer.mPlanes[0].mSkip = 0;
-    // Cb plane.
-    buffer.mPlanes[1].mData =
-        static_cast<uint8_t*>(CVPixelBufferGetBaseAddressOfPlane(aImage, 1));
-    buffer.mPlanes[1].mStride = CVPixelBufferGetBytesPerRowOfPlane(aImage, 1);
-    buffer.mPlanes[1].mWidth = (width + 1) / 2;
-    buffer.mPlanes[1].mHeight = (height + 1) / 2;
-    buffer.mPlanes[1].mSkip = 0;
-    // Cr plane.
-    buffer.mPlanes[2].mData =
-        static_cast<uint8_t*>(CVPixelBufferGetBaseAddressOfPlane(aImage, 2));
-    buffer.mPlanes[2].mStride = CVPixelBufferGetBytesPerRowOfPlane(aImage, 2);
-    buffer.mPlanes[2].mWidth = (width + 1) / 2;
-    buffer.mPlanes[2].mHeight = (height + 1) / 2;
-    buffer.mPlanes[2].mSkip = 0;
+#if defined(MOZ_IOS_LEGACY)
+    if (CVPixelBufferGetPlaneCount(aImage) == 2) {
+      // iOS 4-7 decode to NV12 only: one plane of interleaved Cb and Cr,
+      // read as two planes that skip every other byte.
+      uint8_t* cbcr =
+          static_cast<uint8_t*>(CVPixelBufferGetBaseAddressOfPlane(aImage, 1));
+      size_t stride = CVPixelBufferGetBytesPerRowOfPlane(aImage, 1);
+      for (int i = 1; i <= 2; i++) {
+        buffer.mPlanes[i].mData = cbcr + (i - 1);
+        buffer.mPlanes[i].mStride = stride;
+        buffer.mPlanes[i].mWidth = (width + 1) / 2;
+        buffer.mPlanes[i].mHeight = (height + 1) / 2;
+        buffer.mPlanes[i].mSkip = 1;
+      }
+    } else
+#endif
+    {
+      // Cb plane.
+      buffer.mPlanes[1].mData =
+          static_cast<uint8_t*>(CVPixelBufferGetBaseAddressOfPlane(aImage, 1));
+      buffer.mPlanes[1].mStride = CVPixelBufferGetBytesPerRowOfPlane(aImage, 1);
+      buffer.mPlanes[1].mWidth = (width + 1) / 2;
+      buffer.mPlanes[1].mHeight = (height + 1) / 2;
+      buffer.mPlanes[1].mSkip = 0;
+      // Cr plane.
+      buffer.mPlanes[2].mData =
+          static_cast<uint8_t*>(CVPixelBufferGetBaseAddressOfPlane(aImage, 2));
+      buffer.mPlanes[2].mStride = CVPixelBufferGetBytesPerRowOfPlane(aImage, 2);
+      buffer.mPlanes[2].mWidth = (width + 1) / 2;
+      buffer.mPlanes[2].mHeight = (height + 1) / 2;
+      buffer.mPlanes[2].mSkip = 0;
+    }
 
     buffer.mChromaSubsampling = gfx::ChromaSubsampling::HALF_WIDTH_AND_HEIGHT;
     buffer.mYUVColorSpace = mColorSpace;
@@ -770,7 +788,12 @@ CFDictionaryRef AppleVTDecoder::CreateDecoderSpecification() {
 CFDictionaryRef AppleVTDecoder::CreateOutputConfiguration() {
   if (mUseSoftwareImages) {
     // Output format type:
+#if defined(MOZ_IOS_LEGACY)
+    // The hardware decoder of iOS 4-7 gives NV12 only.
+    SInt32 PixelFormatTypeValue = kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange;
+#else
     SInt32 PixelFormatTypeValue = kCVPixelFormatType_420YpCbCr8Planar;
+#endif
     AutoCFTypeRef<CFNumberRef> PixelFormatTypeNumber(CFNumberCreate(
         kCFAllocatorDefault, kCFNumberSInt32Type, &PixelFormatTypeValue));
     const void* outputKeys[] = {kCVPixelBufferPixelFormatTypeKey};
-- 
