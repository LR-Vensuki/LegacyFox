diff --git a/gfx/layers/NativeLayerMacSurfaceHandler.mm b/gfx/layers/NativeLayerMacSurfaceHandler.mm
index 46f6d78ef8..01d0e276b1 100644
--- a/gfx/layers/NativeLayerMacSurfaceHandler.mm
+++ b/gfx/layers/NativeLayerMacSurfaceHandler.mm
@@ -208,6 +208,42 @@ RefPtr<gfx::DrawTarget> NativeLayerMacSurfaceHandler::NextSurfaceAsDrawTarget(
   return dt;
 }
 
+#if defined(MOZ_IOS_LEGACY)
+CFTypeRefPtr<IOSurfaceRef> NativeLayerMacSurfaceHandler::NextSurfaceAsIOSurface(
+    const IntRect& aDisplayRect, const IntRegion& aUpdateRegion) {
+  if (!NextSurface()) {
+    return nullptr;
+  }
+  CFTypeRefPtr<IOSurfaceRef> target = mInProgressSurface->mSurface;
+  HandlePartialUpdate(
+      aDisplayRect, aUpdateRegion,
+      [&](CFTypeRefPtr<IOSurfaceRef> validSource,
+          const gfx::IntRegion& copyRegion) {
+        IOSurfaceRef src = validSource.get();
+        IOSurfaceRef dst = target.get();
+        if (IOSurfaceLock(src, kIOSurfaceLockReadOnly, nullptr) != 0) {
+          return;
+        }
+        if (IOSurfaceLock(dst, 0, nullptr) == 0) {
+          const uint8_t* s = (const uint8_t*)IOSurfaceGetBaseAddress(src);
+          uint8_t* d = (uint8_t*)IOSurfaceGetBaseAddress(dst);
+          size_t sStride = IOSurfaceGetBytesPerRow(src);
+          size_t dStride = IOSurfaceGetBytesPerRow(dst);
+          for (auto iter = copyRegion.RectIter(); !iter.Done(); iter.Next()) {
+            const gfx::IntRect& r = iter.Get();
+            for (int y = r.y; y < r.YMost(); y++) {
+              memcpy(d + y * dStride + r.x * 4, s + y * sStride + r.x * 4,
+                     size_t(r.width) * 4);
+            }
+          }
+          IOSurfaceUnlock(dst, 0, nullptr);
+        }
+        IOSurfaceUnlock(src, kIOSurfaceLockReadOnly, nullptr);
+      });
+  return target;
+}
+#endif
