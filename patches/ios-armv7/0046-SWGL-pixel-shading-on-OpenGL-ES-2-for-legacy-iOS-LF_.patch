+namespace swgl_gpu {
+
+static GLuint compile_shader(GLenum type, const char* src, const char* name) {
+  GLuint s = glCreateShader(type);
+  glShaderSource(s, 1, &src, nullptr);
+  glCompileShader(s);
+  GLint ok = 0;
+  glGetShaderiv(s, ES_COMPILE_STATUS, &ok);
+  if (!ok) {
+    char log[1024] = "";
+    glGetShaderInfoLog(s, sizeof(log), nullptr, log);
+    fprintf(stderr, "gpu: %s does not compile: %s\n", name, log);
+    glDeleteShader(s);
+    return 0;
+  }
+  return s;
+}
+
+static GLuint link_program(GLuint vs, GLuint fs, int slots, const char* name) {
+  GLuint p = glCreateProgram();
+  glAttachShader(p, vs);
+  glAttachShader(p, fs);
+  glBindAttribLocation(p, 0, "glsl_pos");
+  char buf[16];
+  for (int i = 0; i < slots; i++) {
+    snprintf(buf, sizeof(buf), "glsl_a%d", i);
+    glBindAttribLocation(p, i + 1, buf);
+  }
+  glLinkProgram(p);
+  GLint ok = 0;
+  glGetProgramiv(p, ES_LINK_STATUS, &ok);
+  if (!ok) {
+    char log[1024] = "";
+    glGetProgramInfoLog(p, sizeof(log), nullptr, log);
+    fprintf(stderr, "gpu: %s does not link: %s\n", name, log);
+    glDeleteProgram(p);
+    return 0;
+  }
+  return p;
+}
+
+static bool has_extension(const char* exts, const char* e) {
+  size_t n = strlen(e);
+  for (const char* p = exts; p && (p = strstr(p, e)); p += n) {
+    if ((p == exts || p[-1] == ' ') && (p[n] == ' ' || p[n] == 0)) return true;
+  }
+  return false;
+}
+
+static void set_filter(GLuint tex, GLenum filter) {
+  glBindTexture(GL_TEXTURE_2D, tex);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, filter);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, filter);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+}
+
+static bool init_backend(GpuBackend* g) {
+  const char* exts = (const char*)glGetString(GL_EXTENSIONS);
+  g->red_ok = has_extension(exts, "GL_EXT_texture_rg");
+  g->float_ok = has_extension(exts, "GL_OES_texture_float");
+  g->minmax_ok = has_extension(exts, "GL_EXT_blend_minmax");
+  g->depth24_ok = has_extension(exts, "GL_OES_depth24");
+  GLint max = 0;
+  glGetIntegerv(GL_MAX_TEXTURE_SIZE, &max);
+  if (max > 0) g->max_texture = max;
+
+  for (int slots = 1; slots <= 8; slots++) {
+    std::string src = "attribute vec4 glsl_pos;\n";
+    char buf[96];
+    for (int i = 0; i < slots; i++) {
+      snprintf(buf, sizeof(buf),
+               "attribute vec4 glsl_a%d;\nvarying vec4 glsl_t%d;\n", i, i);
+      src += buf;
+    }
+    src += "void main() {\n gl_Position = glsl_pos;\n";
+    for (int i = 0; i < slots; i++) {
+      snprintf(buf, sizeof(buf), " glsl_t%d = glsl_a%d;\n", i, i);
+      src += buf;
+    }
+    src += "}\n";
+    g->vs[slots] = compile_shader(GL_VERTEX_SHADER, src.c_str(), "vertex stage");
+    if (!g->vs[slots]) return false;
+  }
+  // Pixels the CPU shaded, placed by the GPU: texture coordinate (u w, v w,
+  // 0, w), divided here so that perspective quads line up.
+  GLuint copy_fs = compile_shader(
+      GL_FRAGMENT_SHADER,
+      "precision highp float;\nvarying vec4 glsl_t0;\nuniform sampler2D "
+      "glsl_tex;\nvoid main() { gl_FragColor = texture2D(glsl_tex, glsl_t0.xy "
+      "/ glsl_t0.w); }\n",
+      "copy");
+  if (!copy_fs) return false;
+  g->copy_prog = link_program(g->vs[1], copy_fs, 1, "copy");
+  glDeleteShader(copy_fs);
+  if (!g->copy_prog) return false;
+
+  glGenBuffers(1, &g->vb);
+  // SWGL's vertex stage leaves a quad's corners in the order they go round
+  // the polygon, so the quad is the fan 0 1 2, 0 2 3.
+  {
+    std::vector<uint16_t> idx(MAX_QUADS_PER_FLUSH * 6);
+    for (int q = 0; q < MAX_QUADS_PER_FLUSH; q++) {
+      uint16_t b = uint16_t(q * 4);
+      uint16_t* o = &idx[q * 6];
+      o[0] = b;
+      o[1] = b + 1;
+      o[2] = b + 2;
+      o[3] = b;
+      o[4] = b + 2;
+      o[5] = b + 3;
+    }
+    glGenBuffers(1, &g->ib);
+    glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, g->ib);
+    glBufferData(GL_ELEMENT_ARRAY_BUFFER, intptr_t(idx.size() * 2), idx.data(),
+                 ES_STATIC_DRAW);
+  }
+  if (g->float_ok) {
+    glGenTextures(1, &g->flat_tex);
+    set_filter(g->flat_tex, GL_NEAREST);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, FLAT_TEX_WIDTH, FLAT_TEX_HEIGHT, 0,
+                 GL_RGBA, GL_FLOAT, nullptr);
+    if (glGetError()) {
+      glDeleteTextures(1, &g->flat_tex);
+      g->flat_tex = 0;
+    }
+  }
+  {
+    // What a sampler with no texture behind it reads, as in GL: (0, 0, 0, 1).
+    glGenTextures(1, &g->empty_tex);
+    set_filter(g->empty_tex, GL_NEAREST);
+    uint32_t black = 0xFF000000;
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, 1, 1, 0, GL_RGBA, GL_UNSIGNED_BYTE,
+                 &black);
+  }
+  glGenFramebuffers(1, &g->read_fbo);
+  return glGetError() == 0;
+}
+
+// Whether a texture of this format can be the GPU's render target.
+static inline bool renderable(GLenum internal_format) {
+  return internal_format == GL_RGBA8 || internal_format == GL_R8;
+}
+
+static inline bool format_on_gpu(GpuBackend* g, GLenum internal_format) {
+  switch (internal_format) {
+    case GL_RGBA8:
+    case GL_R8:
+    case GL_DEPTH_COMPONENT24:
+      return true;
+    case GL_RGBA32F:
+    case GL_RGBA32I:
+      return g->float_ok;
+    default:
+      return false;
+  }
+}
+
+static int64_t texel_bytes(GLenum internal_format, bool expanded, int64_t w,
+                           int64_t h) {
+  int b = internal_format == GL_R8 && !expanded            ? 1
+          : internal_format == GL_RGBA32F ||
+                  internal_format == GL_RGBA32I            ? 16
+                                                           : 4;
+  return w * h * b;
+}
+
+// Makes sure t has a GPU copy of the right size and format. Returns false if
+// its format has no place on this device.
+static bool ensure_resource(GpuBackend* g, Texture& t, int min_w = 0,
+                            int min_h = 0) {
+  if (!t.gpu) t.gpu = new GpuTex;
+  GpuTex& gt = *t.gpu;
+  if (gt.external) return gt.tex != 0;
+  int want_w = std::max(t.width, min_w);
+  int want_h = std::max(t.height, min_h);
+  bool depth = t.internal_format == GL_DEPTH_COMPONENT24;
+  bool exact = depth && (min_w > 0 || min_h > 0);
+  if ((gt.tex || gt.rb) && gt.width == t.width && gt.height == t.height &&
+      gt.internal_format == t.internal_format &&
+      (exact ? gt.tex_w == want_w && gt.tex_h == want_h
+             : gt.tex_w >= want_w && gt.tex_h >= want_h)) {
+    return true;
+  }
+  bool keep_resident = gt.resident && !t.buf;
+  gt.release();
+  if (keep_resident) mark_resident(gt, t);
+  if (t.width <= 0 || t.height <= 0) return false;
+  if (!format_on_gpu(g, t.internal_format)) return false;
+  if (want_w > g->max_texture || want_h > g->max_texture) return false;
+  glGetError();
+  if (depth) {
+    glGenRenderbuffers(1, &gt.rb);
+    glBindRenderbuffer(GL_RENDERBUFFER, gt.rb);
+    glRenderbufferStorage(GL_RENDERBUFFER,
+                          g->depth24_ok ? ES_DEPTH24 : ES_DEPTH16, want_w,
+                          want_h);
+  } else {
+    glGenTextures(1, &gt.tex);
+    set_filter(gt.tex, GL_NEAREST);
+    gt.filter = GL_NEAREST;
+    gt.expanded = false;
+    switch (t.internal_format) {
+      case GL_RGBA8:
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, want_w, want_h, 0, ES_BGRA,
+                     GL_UNSIGNED_BYTE, nullptr);
+        break;
+      case GL_R8:
+        if (g->red_ok) {
+          glTexImage2D(GL_TEXTURE_2D, 0, ES_RED, want_w, want_h, 0, ES_RED,
+                       GL_UNSIGNED_BYTE, nullptr);
+        } else {
+          gt.expanded = true;
+          glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, want_w, want_h, 0, ES_BGRA,
+                       GL_UNSIGNED_BYTE, nullptr);
+        }
+        break;
+      default:
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, want_w, want_h, 0, GL_RGBA,
+                     GL_FLOAT, nullptr);
+        break;
+    }
+  }
+  if (glGetError()) {
+    gt.release();
+    return false;
+  }
+  gt.internal_format = t.internal_format;
+  gt.width = t.width;
+  gt.height = t.height;
+  gt.tex_w = want_w;
+  gt.tex_h = want_h;
+  gt.gpu_size = texel_bytes(t.internal_format, gt.expanded, want_w, want_h);
+  gpu_tex_bytes += gt.gpu_size;
+  gt.gpu_newer = false;
+  gt.cpu_newer = !gt.resident;
+  return true;
+}
+
+// The framebuffer that draws into gt (and depth, a renderbuffer, or none).
+static bool bind_target(GpuBackend* g, GpuTex& gt, GpuTex* depth) {
+  if (!gt.fbo) {
+    glGenFramebuffers(1, &gt.fbo);
+    glBindFramebuffer(GL_FRAMEBUFFER, gt.fbo);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D,
+                           gt.tex, 0);
+    if (glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE) {
+      if (trace()) fprintf(stderr, "gpu: %dx%d is no render target\n", gt.width, gt.height);
+      glDeleteFramebuffers(1, &gt.fbo);
+      gt.fbo = 0;
+      return false;
+    }
+  } else {
+    glBindFramebuffer(GL_FRAMEBUFFER, gt.fbo);
+  }
+  GLuint want = depth ? depth->rb : 0;
+  if (gt.fbo_depth != want) {
+    glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT,
+                              GL_RENDERBUFFER, want);
+    gt.fbo_depth = want;
+    if (want &&
+        glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE) {
+      glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT,
+                                GL_RENDERBUFFER, 0);
+      gt.fbo_depth = 0;
+      return false;
+    }
+  }
+  return true;
+}
+
+// Writes the rectangle [x0, x1) x [y0, y1) of the CPU buffer into the GPU copy.
+static void upload_rows(GpuBackend* g, Texture& t, int x0, int y0, int x1,
+                        int y1) {
+  GpuTex& gt = *t.gpu;
+  if (!t.buf || x1 <= x0 || y1 <= y0 || !gt.tex) return;
+  int w = x1 - x0;
+  int h = y1 - y0;
+  glBindTexture(GL_TEXTURE_2D, gt.tex);
+  glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+  // GLES 2 has no unpack row length: whole rows go up as they are, a
+  // narrower rectangle row by row out of a packed copy.
+  auto send = [&](GLenum format, GLenum type, int bpp) {
+    if (x0 == 0 && w == t.width && size_t(t.stride()) == size_t(w) * bpp) {
+      glTexSubImage2D(GL_TEXTURE_2D, 0, gt.ox, y0 + gt.oy, w, h, format, type,
+                      t.sample_ptr(0, y0));
+    } else {
+      g->rows.resize(size_t(w) * h * bpp);
+      for (int y = 0; y < h; y++) {
+        memcpy(&g->rows[size_t(y) * w * bpp], t.sample_ptr(x0, y0 + y),
+               size_t(w) * bpp);
+      }
+      glTexSubImage2D(GL_TEXTURE_2D, 0, x0 + gt.ox, y0 + gt.oy, w, h, format,
+                      type, g->rows.data());
+    }
+  };
+  if (t.internal_format == GL_RGBA8) {
+    send(ES_BGRA, GL_UNSIGNED_BYTE, 4);
+  } else if (t.internal_format == GL_R8 && !gt.expanded) {
+    send(ES_RED, GL_UNSIGNED_BYTE, 1);
+  } else if (t.internal_format == GL_R8) {
+    g->rows.resize(size_t(w) * h * 4);
+    for (int y = 0; y < h; y++) {
+      copy_red_to_bgra8(&g->rows[size_t(y) * w * 4],
+                        (const uint8_t*)t.sample_ptr(x0, y0 + y), w);
+    }
+    glTexSubImage2D(GL_TEXTURE_2D, 0, x0 + gt.ox, y0 + gt.oy, w, h, ES_BGRA,
+                    GL_UNSIGNED_BYTE, g->rows.data());
+  } else if (t.internal_format == GL_RGBA32I) {
+    g->rows.resize(size_t(w) * h * 16);
+    float* f = (float*)g->rows.data();
+    for (int y = 0; y < h; y++) {
+      const int32_t* s = (const int32_t*)t.sample_ptr(x0, y0 + y);
+      for (int i = 0; i < w * 4; i++) f[size_t(y) * w * 4 + i] = float(s[i]);
+    }
+    glTexSubImage2D(GL_TEXTURE_2D, 0, x0, y0, w, h, GL_RGBA, GL_FLOAT, f);
+  } else if (t.internal_format == GL_RGBA32F) {
+    send(GL_RGBA, GL_FLOAT, 16);
+  }
+  g->stats.uploads++;
+  if (trace()) {
+    fprintf(stderr, "gpu: upload %dx%d of %dx%d fmt %x\n", w, h, t.width,
+            t.height, t.internal_format);
+  }
+}
+
+// Copies the GPU copy back into the CPU buffer.
+static void readback(GpuBackend* g, Texture& t) {
+  GpuTex& gt = *t.gpu;
+  if (!t.buf || !gt.tex) return;
+  if (t.internal_format == GL_DEPTH_COMPONENT24) {
+    // GLES 2 reads no depth back. Everything drawn with depth has a GPU
+    // shader, as at 9_3.
+    g->stats.depth_lost++;
+    return;
+  }
+  if (!renderable(t.internal_format)) return;
+  if (gt.fbo) {
+    glBindFramebuffer(GL_FRAMEBUFFER, gt.fbo);
+  } else {
+    glBindFramebuffer(GL_FRAMEBUFFER, g->read_fbo);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D,
+                           gt.tex, 0);
+  }
+  g->rows.resize(size_t(t.width) * t.height * 4);
+  glPixelStorei(ES_PACK_ALIGNMENT, 1);
+  glReadPixels(gt.ox, gt.oy, t.width, t.height, GL_RGBA, GL_UNSIGNED_BYTE,
+               g->rows.data());
+  for (int y = 0; y < t.height; y++) {
+    const uint8_t* src = &g->rows[size_t(y) * t.width * 4];
+    uint8_t* dst = (uint8_t*)t.sample_ptr(0, y);
+    if (t.internal_format == GL_R8) {
+      for (int x = 0; x < t.width; x++) dst[x] = src[x * 4];
+    } else {
+      for (int x = 0; x < t.width; x++) {
+        dst[x * 4 + 0] = src[x * 4 + 2];
+        dst[x * 4 + 1] = src[x * 4 + 1];
+        dst[x * 4 + 2] = src[x * 4 + 0];
+        dst[x * 4 + 3] = src[x * 4 + 3];
+      }
+    }
+  }
+  g->stats.readbacks++;
+  if (trace()) {
+    fprintf(stderr, "gpu: readback %dx%d fmt %x\n", t.width, t.height,
+            t.internal_format);
+  }
+}
+
+// Fills a rectangle of gt's framebuffer (in its texture's pixels) with a
+// colour, or its depth buffer with a depth.
+static void clear_rect(GpuBackend* g, GpuTex& gt, GpuTex* depth, int x0,
+                       int y0, int x1, int y1, const float* color,
+                       float depth_value) {
+  glEnable(GL_SCISSOR_TEST);
+  glScissor(x0, y0, x1 - x0, y1 - y0);
+  if (depth) {
+    glDepthMask(1);
+    glClearDepthf(depth_value);
+    glClear(GL_DEPTH_BUFFER_BIT);
+  } else {
+    glColorMask(1, 1, 1, 1);
+    glClearColor(color[0], color[1], color[2], color[3]);
+    glClear(GL_COLOR_BUFFER_BIT);
+  }
+}
+
+// Before the GPU reads or draws into t: make the GPU copy current.
+static bool to_gpu(GpuBackend* g, Texture& t) {
+  if (!ensure_resource(g, t)) return false;
+  GpuTex& gt = *t.gpu;
+  if (gt.cpu_newer) {
+    if (t.internal_format == GL_DEPTH_COMPONENT24) {
+      // What SWGL holds is almost always one clear value; the depth buffer
+      // is cleared to it when it is attached (gpu_draw_elements).
+      if (t.cleared() && t.buf) {
+        uint32_t first = 0;
+        for (int y = 0; y < t.height; y++) {
+          DepthRun* row = (DepthRun*)t.sample_ptr(0, y);
+          flatten_depth_runs(row, t.width);
+          const uint32_t* v = (const uint32_t*)row;
+          if (y == 0) first = v[0] & 0xFFFFFF;
+          for (int x = 0; x < t.width; x++) {
+            if ((v[x] & 0xFFFFFF) != first) return false;
+          }
+        }
+        gt.pending_depth = float(first) / float(0xFFFFFF);
+      }
+    } else if (t.delay_clear && renderable(t.internal_format) &&
+               t.delay_clear >= t.height) {
+      uint32_t c = t.clear_val;
+      float color[4];
+      if (t.internal_format == GL_R8) {
+        color[0] = (c & 0xFF) / 255.0f;
+        color[1] = color[2] = 0.0f;
+        color[3] = 1.0f;
+      } else {
+        color[0] = ((c >> 16) & 0xFF) / 255.0f;
+        color[1] = ((c >> 8) & 0xFF) / 255.0f;
+        color[2] = (c & 0xFF) / 255.0f;
+        color[3] = ((c >> 24) & 0xFF) / 255.0f;
+      }
+      if (!bind_target(g, gt, nullptr)) return false;
+      clear_rect(g, gt, nullptr, gt.ox, gt.oy, gt.ox + t.width,
+                 gt.oy + t.height, color, 0);
+      t.disable_delayed_clear();
+      g->stats.gpu_clears++;
+    } else {
+      if (t.delay_clear) prepare_texture(t);
+      upload_rows(g, t, 0, 0, t.width, t.height);
+    }
+    gt.cpu_newer = false;
+  }
+  return true;
+}
+
+static bool blend_supported(GpuBackend* g) {
+  if (!ctx->blend) return true;
+  switch (ctx->blend_equation) {
+    case GL_FUNC_ADD:
+      break;
+    case GL_MIN:
+    case GL_MAX:
+      if (!g->minmax_ok) return false;
+      break;
+    default:
+      return false;
+  }
+  for (GLenum f : {ctx->blendfunc_srgb, ctx->blendfunc_drgb, ctx->blendfunc_sa,
+                   ctx->blendfunc_da}) {
+    switch (f) {
+      case GL_ZERO:
+      case GL_ONE:
+      case GL_SRC_COLOR:
+      case GL_ONE_MINUS_SRC_COLOR:
+      case GL_SRC_ALPHA:
+      case GL_ONE_MINUS_SRC_ALPHA:
+      case GL_DST_ALPHA:
+      case GL_ONE_MINUS_DST_ALPHA:
+      case GL_DST_COLOR:
+      case GL_ONE_MINUS_DST_COLOR:
+      case GL_CONSTANT_COLOR:
+      case GL_ONE_MINUS_CONSTANT_COLOR:
+        break;
+      default:
+        return false;
+    }
+  }
+  return true;
+}
+
+static void set_blend() {
+  if (!ctx->blend) {
+    glDisable(GL_BLEND);
+    return;
+  }
+  glEnable(GL_BLEND);
+  glBlendEquation(ctx->blend_equation);
+  glBlendFuncSeparate(ctx->blendfunc_srgb, ctx->blendfunc_drgb,
+                      ctx->blendfunc_sa, ctx->blendfunc_da);
+  // blendcolor is kept in BGRA order.
+  glBlendColor(ctx->blendcolor[2] / 255.0f, ctx->blendcolor[1] / 255.0f,
+               ctx->blendcolor[0] / 255.0f, ctx->blendcolor[3] / 255.0f);
+}
+
+// A copy of a texture that is also the draw's target, for reading from: GL
+// leaves sampling a texture while drawing into it undefined.
+static GLuint feedback_copy(GpuBackend* g, GpuTex& gt) {
+  GLenum format = gt.internal_format == GL_R8 && !gt.expanded ? ES_RED : GL_RGBA;
+  GpuBackend::Feedback* f = nullptr;
+  for (auto& e : g->feedback) {
+    if (e.format == format && e.w == gt.width && e.h == gt.height) f = &e;
+  }
+  if (!f) {
+    if (g->feedback.size() >= 2) {
+      for (auto& e : g->feedback) {
+        gpu_cache_bytes -= texel_bytes(GL_RGBA8, false, e.w, e.h);
+        glDeleteTextures(1, &e.tex);
+      }
+      g->feedback.clear();
+    }
+    GpuBackend::Feedback n = {0, format, gt.width, gt.height};
+    glGenTextures(1, &n.tex);
+    set_filter(n.tex, GL_NEAREST);
+    glTexImage2D(GL_TEXTURE_2D, 0, format, gt.width, gt.height, 0,
+                 format == ES_RED ? ES_RED : ES_BGRA, GL_UNSIGNED_BYTE, nullptr);
+    gpu_cache_bytes += texel_bytes(GL_RGBA8, false, gt.width, gt.height);
+    g->feedback.push_back(n);
+    f = &g->feedback.back();
+  }
+  // The target's framebuffer is bound: copy out of it.
+  glBindTexture(GL_TEXTURE_2D, f->tex);
+  glCopyTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, gt.ox, gt.oy, gt.width,
+                      gt.height);
+  if (trace()) fprintf(stderr, "gpu: feedback copy %dx%d\n", gt.width, gt.height);
+  return f->tex;
+}
+
+static GpuProgram* program_for(GpuBackend* g, const GpuProgramInfo* info) {
+  auto it = g->programs.find(info);
+  if (it != g->programs.end()) return &it->second;
+  if (g->refused.count(info)) return nullptr;
+  GpuProgram p;
+  GLuint fs = compile_shader(GL_FRAGMENT_SHADER, (const char*)info->ps,
+                             info->name);
+  if (fs) {
+    p.prog = link_program(g->vs[info->slots], fs, info->slots, info->name);
+    glDeleteShader(fs);
+  }
+  if (!p.prog) {
+    g->refused[info] = true;
+    return nullptr;
+  }
+  glUseProgram(p.prog);
+  char buf[32];
+  for (int i = 0; i < MAX_SAMPLERS; i++) {
+    p.sampler_size[i] = -1;
+    if (i >= info->num_samplers) continue;
+    snprintf(buf, sizeof(buf), "glsl_s%d", i);
+    glUniform1i(glGetUniformLocation(p.prog, buf), i);
+    snprintf(buf, sizeof(buf), "glsl_size%d", i);
+    p.sampler_size[i] = glGetUniformLocation(p.prog, buf);
+  }
+  if (info->texture_floats > 0) {
+    glUniform1i(glGetUniformLocation(p.prog, "glsl_flat"), info->num_samplers);
+    p.flat_size = glGetUniformLocation(p.prog, "glsl_flat_size");
+  }
+  return &(g->programs[info] = p);
+}
+
+static void set_viewport(GpuTex& gt, Texture& colortex) {
+  // SWGL subtracts the texture's offset after the viewport transform.
+  glViewport(ctx->viewport.x0 - colortex.offset.x + gt.ox,
+             ctx->viewport.y0 - colortex.offset.y + gt.oy,
+             ctx->viewport.width(), ctx->viewport.height());
+  IntRect sc = ctx->apply_scissor(colortex);
+  glEnable(GL_SCISSOR_TEST);
+  glScissor(sc.x0 + gt.ox, sc.y0 + gt.oy, std::max(sc.width(), 0),
+            std::max(sc.height(), 0));
+  glDisable(ES_CULL_FACE);
+  glDisable(ES_DITHER);
+  glColorMask(1, 1, 1, 1);
+}
+
+// Depth for a draw: the renderbuffer attached, any pending clear applied, the
+// test set. False if the depth buffer cannot be on the GPU.
+static bool set_depth(GpuBackend* g, Texture& colortex, Texture* depthtex) {
+  if (!depthtex) {
+    glDisable(GL_DEPTH_TEST);
+    glDepthMask(0);
+    return bind_target(g, *colortex.gpu, nullptr);
+  }
+  if (!bind_target(g, *colortex.gpu, depthtex->gpu)) return false;
+  GpuTex& dt = *depthtex->gpu;
+  if (dt.pending_depth >= 0.0f) {
+    GpuTex& ct = *colortex.gpu;
+    clear_rect(g, ct, &dt, 0, 0, ct.tex_w, ct.tex_h, nullptr, dt.pending_depth);
+    dt.pending_depth = -1.0f;
+    g->stats.gpu_clears++;
+  }
+  glEnable(GL_DEPTH_TEST);
+  glDepthFunc(ctx->depthfunc == GL_LEQUAL ? GL_LEQUAL : GL_LESS);
+  glDepthMask(ctx->depthmask ? 1 : 0);
+  return true;
+}
+
+static void draw_quads(GpuBackend* g, const float* verts, int quads, int slots) {
+  const int vstride = 16 * (1 + slots);
+  glBindBuffer(GL_ARRAY_BUFFER, g->vb);
+  glBufferData(GL_ARRAY_BUFFER, intptr_t(quads) * 4 * vstride, verts,
+               ES_STREAM_DRAW);
+  for (int i = 0; i <= slots; i++) {
+    glEnableVertexAttribArray(i);
+    glVertexAttribPointer(i, 4, GL_FLOAT, 0, vstride, (const void*)intptr_t(16 * i));
+  }
+  for (int i = slots + 1; i <= 8; i++) glDisableVertexAttribArray(i);
+  glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, g->ib);
+  glDrawElements(GL_TRIANGLES, quads * 6, GL_UNSIGNED_SHORT, nullptr);
+}
