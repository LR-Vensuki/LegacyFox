+// SWGL_GPU_TRACE=1: a line on stderr for every draw, clear, upload and
+// readback.
+static bool trace() {
+  static int on = -1;
+  if (on < 0) on = getenv("SWGL_GPU_TRACE") ? 1 : 0;
+  return on == 1;
+}
+
+static const int MAX_QUADS_PER_FLUSH = 2048;
+static const int FLAT_TEX_WIDTH = 1024;
+static const int FLAT_TEX_HEIGHT = 64;
+static const int MAX_SAMPLERS = 8;
+
+static int64_t resident_bytes = 0;
+static int64_t gpu_tex_bytes = 0;
+static int64_t gpu_cache_bytes = 0;
+
+}  // namespace swgl_gpu
+
+// The GPU side of one SWGL texture.
+struct GpuTex {
+  GLuint tex = 0;
+  // A depth texture is a renderbuffer.
+  GLuint rb = 0;
+  // Its framebuffer, made when it is first drawn into.
+  GLuint fbo = 0;
+  GLuint fbo_depth = 0;
+  GLenum internal_format = 0;
+  int width = 0;
+  int height = 0;
+  bool gpu_newer = false;
+  bool cpu_newer = true;
+  // An R8 texture stored as BGRA, where the GPU cannot render red alone.
+  bool expanded = false;
+  // A compositor tile's texture, which belongs to someone else; this SWGL
+  // texture is its rectangle at (ox, oy).
+  bool external = false;
+  int ox = 0;
+  int oy = 0;
+  bool resident = false;
+  int tex_w = 0;
+  int tex_h = 0;
+  GLenum filter = 0;
+  // A depth value the CPU's depth runs hold everywhere, to clear the
+  // renderbuffer to when it is next attached; negative for none.
+  float pending_depth = -1.0f;
+  int64_t resident_size = 0;
+  int64_t gpu_size = 0;
+
+  void release() {
+    if (resident) {
+      swgl_gpu::resident_bytes -= resident_size;
+      resident_size = 0;
+    }
+    swgl_gpu::gpu_tex_bytes -= gpu_size;
+    gpu_size = 0;
+    if (fbo) glDeleteFramebuffers(1, &fbo);
+    if (tex && !external) glDeleteTextures(1, &tex);
+    if (rb) glDeleteRenderbuffers(1, &rb);
+    fbo = tex = rb = fbo_depth = 0;
+    width = height = 0;
+    tex_w = tex_h = 0;
+    filter = 0;
+    external = false;
+    resident = false;
+    ox = oy = 0;
+  }
+  ~GpuTex() { release(); }
+};
+
+namespace swgl_gpu {
+
+static void mark_resident(GpuTex& gt, const Texture& t) {
+  if (gt.resident) return;
+  gt.resident = true;
+  gt.resident_size =
+      int64_t(t.width) * t.height * (t.internal_format == GL_R8 ? 1 : 4);
+  resident_bytes += gt.resident_size;
+}
+
+static void unmark_resident(GpuTex& gt) {
+  if (!gt.resident) return;
+  gt.resident = false;
+  resident_bytes -= gt.resident_size;
+  gt.resident_size = 0;
+}
+
+}  // namespace swgl_gpu
+
+// A pixel shader compiled and linked with the pass-through vertex shader.
+struct GpuProgram {
+  GLuint prog = 0;
+  GLint sampler_size[swgl_gpu::MAX_SAMPLERS];
+  GLint flat_size = -1;
+};
+
+struct GpuBackend {
+  bool red_ok = false;
+  bool float_ok = false;
+  bool minmax_ok = false;
+  bool depth24_ok = false;
+  int max_texture = 2048;
+
+  GLuint vs[9] = {};
+  GLuint copy_prog = 0;
+  Texture* scratch = nullptr;
+  bool recording = false;
+  std::vector<float> recorded;
+
+  GLuint vb = 0;
+  GLuint ib = 0;
+  GLuint flat_tex = 0;
+  GLuint empty_tex = 0;
+  // A framebuffer for reading textures that are not render targets.
+  GLuint read_fbo = 0;
+
+  std::unordered_map<const GpuProgramInfo*, GpuProgram> programs;
+  std::unordered_map<const GpuProgramInfo*, bool> refused;
+
+  std::vector<float> verts;
+  std::vector<float> flats;
+  std::vector<char> interps;
+  std::vector<uint8_t> rows;
+
+  // Copies of render targets that a draw also samples.
+  struct Feedback {
+    GLuint tex;
+    GLenum format;
+    int w, h;
+  };
+  std::vector<Feedback> feedback;
+
+  bool broken = false;
+
+  struct Stats {
+    uint32_t gpu_draws = 0;
+    uint32_t cpu_draws = 0;
+    uint32_t gpu_quads = 0;
+    uint32_t uploads = 0;
+    uint32_t readbacks = 0;
+    uint32_t gpu_clears = 0;
+    uint32_t refused_program = 0;
+    uint32_t refused_state = 0;
+    uint32_t depth_lost = 0;
+    uint32_t cpu_freed = 0;
+    uint32_t cpu_restored = 0;
+  } stats;
+
+  ~GpuBackend() {
+    delete scratch;
+    for (auto& v : vs) {
+      if (v) glDeleteShader(v);
+    }
+    if (copy_prog) glDeleteProgram(copy_prog);
+    for (auto& p : programs) glDeleteProgram(p.second.prog);
+    if (vb) glDeleteBuffers(1, &vb);
+    if (ib) glDeleteBuffers(1, &ib);
+    if (flat_tex) glDeleteTextures(1, &flat_tex);
+    if (empty_tex) glDeleteTextures(1, &empty_tex);
+    if (read_fbo) glDeleteFramebuffers(1, &read_fbo);
+    for (auto& f : feedback) glDeleteTextures(1, &f.tex);
+  }
+};
