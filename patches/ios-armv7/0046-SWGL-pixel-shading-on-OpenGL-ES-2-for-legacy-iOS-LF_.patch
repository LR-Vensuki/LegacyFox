@@ -140,6 +140,14 @@ class NativeLayerMacSurfaceHandler {
                                          const gfx::IntRegion& aUpdateRegion,
                                          bool aNeedsDepth);
 
+#if defined(MOZ_IOS_LEGACY)
+  // The next surface itself, for a GPU that draws into it through a texture
+  // of its own (SWGL's pixel shading on OpenGL ES 2). Valid content the
+  // update leaves alone is copied in on the CPU.
+  CFTypeRefPtr<IOSurfaceRef> NextSurfaceAsIOSurface(
+      const gfx::IntRect& aDisplayRect, const gfx::IntRegion& aUpdateRegion);
+#endif
