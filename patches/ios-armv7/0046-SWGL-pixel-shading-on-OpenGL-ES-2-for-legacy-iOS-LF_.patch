+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef MOZILLA_GFX_RENDERCOMPOSITOR_SWGL_GPU_H
+#define MOZILLA_GFX_RENDERCOMPOSITOR_SWGL_GPU_H
+
+// An OpenGL ES 2 context for SWGL's pixel shading on legacy iOS (gpu_gles2.h
+// in swgl), and GL textures over the IOSurfaces of compositor tiles.
+
+#include <stdint.h>
+#include <IOSurface/IOSurfaceRef.h>
+
+namespace mozilla::wr {
+
+struct SwglGpuEAGL;
+
+// Null if the device has no OpenGL ES 2 or cannot bind IOSurfaces.
+SwglGpuEAGL* SwglGpuEAGLCreate();
+bool SwglGpuEAGLMakeCurrent(SwglGpuEAGL* aGpu);
+void SwglGpuEAGLDestroy(SwglGpuEAGL* aGpu);
+// A texture of the current context that is aSurface; 0 on failure.
+uint32_t SwglGpuEAGLTexture(SwglGpuEAGL* aGpu, IOSurfaceRef aSurface);
+
+}  // namespace mozilla::wr
+
+extern "C" {
+// swgl's gpu_gles2.h.
+struct SwglGpuGLTile {
+  uint32_t texture;
+  int32_t width;
+  int32_t height;
+};
+bool SwglGpuAttach(void* current);
+void SwglGpuDescribe(char* out, size_t size);
+void SwglGpuFinish();
+void SwglGpuStats(uint32_t* out8);
+}
+
+#endif
diff --git a/gfx/webrender_bindings/RenderCompositorSWGLGPU.mm b/gfx/webrender_bindings/RenderCompositorSWGLGPU.mm
new file mode 100644
index 0000000000..564549da98
--- /dev/null
+++ b/gfx/webrender_bindings/RenderCompositorSWGLGPU.mm
@@ -0,0 +1,119 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "RenderCompositorSWGLGPU.h"
+
+#import <OpenGLES/EAGL.h>
+#import <OpenGLES/ES2/gl.h>
+#import <OpenGLES/ES2/glext.h>
+
+#include <vector>
+
+// The iOS 5-10 form of EAGLContext's IOSurface binding; iOS 11 made public
+// one without `invert`.
+@interface EAGLContext (LegacyFoxIOSurfaceInvert)
+- (BOOL)texImageIOSurface:(IOSurfaceRef)ioSurface
+                   target:(NSUInteger)target
+           internalFormat:(NSUInteger)internalFormat
+                    width:(uint32_t)width
+                   height:(uint32_t)height
+                   format:(NSUInteger)format
+                     type:(NSUInteger)type
+                    plane:(uint32_t)plane
+                   invert:(BOOL)invert;
+@end
+
+namespace mozilla::wr {
+
+struct SwglGpuEAGL {
+  EAGLContext* mContext = nil;
+  struct Entry {
+    IOSurfaceRef mSurface;
+    uint32_t mId;
+    GLuint mTexture;
+    uint64_t mLastUse;
+  };
+  std::vector<Entry> mTextures;
+  uint64_t mUse = 0;
+};
+
+// Tiles come in a few sizes and a three-deep swap chain each; textures for
+// surfaces gone from the pool are dropped as new ones come.
+static const size_t kMaxTextures = 48;
+
+SwglGpuEAGL* SwglGpuEAGLCreate() {
+  EAGLContext* context =
+      [[EAGLContext alloc] initWithAPI:kEAGLRenderingAPIOpenGLES2];
+  if (!context ||
+      ![context respondsToSelector:@selector
+                (texImageIOSurface:target:internalFormat:width:height:format:type:plane:invert:)]) {
+    [context release];
+    return nullptr;
+  }
+  SwglGpuEAGL* gpu = new SwglGpuEAGL;
+  gpu->mContext = context;
+  return gpu;
+}
+
+bool SwglGpuEAGLMakeCurrent(SwglGpuEAGL* aGpu) {
+  return [EAGLContext setCurrentContext:aGpu->mContext];
+}
+
+void SwglGpuEAGLDestroy(SwglGpuEAGL* aGpu) {
+  if (!aGpu) {
+    return;
+  }
+  [EAGLContext setCurrentContext:aGpu->mContext];
+  for (auto& e : aGpu->mTextures) {
+    glDeleteTextures(1, &e.mTexture);
+  }
+  [EAGLContext setCurrentContext:nil];
+  [aGpu->mContext release];
+  delete aGpu;
+}
+
+uint32_t SwglGpuEAGLTexture(SwglGpuEAGL* aGpu, IOSurfaceRef aSurface) {
+  uint32_t id = IOSurfaceGetID(aSurface);
+  aGpu->mUse++;
+  for (auto& e : aGpu->mTextures) {
+    if (e.mSurface == aSurface && e.mId == id) {
+      e.mLastUse = aGpu->mUse;
+      return e.mTexture;
+    }
+  }
+  if (aGpu->mTextures.size() >= kMaxTextures) {
+    auto oldest = aGpu->mTextures.begin();
+    for (auto it = aGpu->mTextures.begin(); it != aGpu->mTextures.end(); ++it) {
+      if (it->mLastUse < oldest->mLastUse) {
+        oldest = it;
+      }
+    }
+    glDeleteTextures(1, &oldest->mTexture);
+    aGpu->mTextures.erase(oldest);
+  }
+  GLuint tex = 0;
+  glGenTextures(1, &tex);
+  glBindTexture(GL_TEXTURE_2D, tex);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+  BOOL ok = [aGpu->mContext texImageIOSurface:aSurface
+                                       target:GL_TEXTURE_2D
+                               internalFormat:GL_RGBA
+                                        width:uint32_t(IOSurfaceGetWidth(aSurface))
+                                       height:uint32_t(IOSurfaceGetHeight(aSurface))
+                                       format:GL_BGRA_EXT
+                                         type:GL_UNSIGNED_BYTE
+                                        plane:0
+                                       invert:NO];
+  if (!ok) {
+    glDeleteTextures(1, &tex);
+    return 0;
+  }
+  aGpu->mTextures.push_back({aSurface, id, tex, aGpu->mUse});
+  return tex;
+}
+
+}  // namespace mozilla::wr
