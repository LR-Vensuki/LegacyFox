+static void gpu_count_cpu_draw() {
+  if (ctx->gpu) {
+    ctx->gpu->stats.cpu_draws++;
+    if (swgl_gpu::trace()) {
+      ProgramImpl* impl = ctx->programs[ctx->current_program].impl;
+      fprintf(stderr, "gpu: CPU draw %s\n", impl ? impl->get_name() : "?");
+    }
+  }
+}
