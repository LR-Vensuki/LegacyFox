+static const GLenum ES_RED = 0x1903;             // GL_RED_EXT
+static const GLenum ES_STREAM_DRAW = 0x88E0;
+static const GLenum ES_STATIC_DRAW = 0x88E4;
+static const GLenum ES_COMPILE_STATUS = 0x8B81;
+static const GLenum ES_LINK_STATUS = 0x8B82;
+static const GLenum ES_CULL_FACE = 0x0B44;
+static const GLenum ES_DITHER = 0x0BD0;
+static const GLenum ES_DEPTH24 = 0x81A6;  // GL_DEPTH_COMPONENT24_OES
+static const GLenum ES_DEPTH16 = 0x81A5;
+static const GLenum ES_PACK_ALIGNMENT = 0x0D05;
