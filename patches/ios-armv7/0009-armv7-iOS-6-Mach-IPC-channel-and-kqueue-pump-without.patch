From ca1259fa7fb6eafd1ba4b1aa70ed03a121950301 Mon Sep 17 00:00:00 2001
From: LR-Vensuki <260785366+LR-Vensuki@users.noreply.github.com>
Date: Thu, 8 Oct 2026 05:49:46 +0300
Subject: [PATCH 09/42] armv7 iOS 6: Mach IPC channel and kqueue pump without
 iOS 7/8 APIs, ProcInfo from TASK_BASIC_INFO, NSS without ARMv8 crypto or
 auxv, no ObjC generics in nsWindow

---
 ipc/chromium/src/base/message_pump_kqueue.cc  |  4 +-
 .../src/chrome/common/ipc_channel_mach.cc     | 36 ++++++++++++-
 security/nss/lib/freebl/blinit.c              | 24 ++++-----
 security/nss/lib/freebl/freebl.gyp            |  9 ++++
 toolkit/components/processtools/ProcInfo.mm   | 53 +++++++++++++++++++
 widget/uikit/nsWindow.mm                      | 18 +++----
 6 files changed, 120 insertions(+), 24 deletions(-)

diff --git a/ipc/chromium/src/base/message_pump_kqueue.cc b/ipc/chromium/src/base/message_pump_kqueue.cc
index 7159a223f4..46c1d5363a 100644
--- a/ipc/chromium/src/base/message_pump_kqueue.cc
+++ b/ipc/chromium/src/base/message_pump_kqueue.cc
@@ -6,7 +6,7 @@
 
 #include <sys/errno.h>
 
-#ifdef XP_IOS
+#if defined(XP_IOS) && !defined(MOZ_IOS_LEGACY)
 #  include <BrowserEngineCore/BEkevent.h>
 #endif
 
@@ -24,7 +24,7 @@ namespace {
 // sandbox, so instead we use `be_kevent64` from the BrowserEngineCore library.
 static int platform_kevent64(int fd, const kevent64_s* changelist, int nchanges,
                              kevent64_s* eventlist, int nevents, int flags) {
-#ifdef XP_IOS
+#if defined(XP_IOS) && !defined(MOZ_IOS_LEGACY)
   return be_kevent64(fd, changelist, nchanges, eventlist, nevents, flags);
 #else
   return kevent64(fd, changelist, nchanges, eventlist, nevents, flags, nullptr);
diff --git a/ipc/chromium/src/chrome/common/ipc_channel_mach.cc b/ipc/chromium/src/chrome/common/ipc_channel_mach.cc
index 68d1b07ba5..7a0ac75ece 100644
--- a/ipc/chromium/src/chrome/common/ipc_channel_mach.cc
+++ b/ipc/chromium/src/chrome/common/ipc_channel_mach.cc
@@ -221,7 +221,11 @@ bool ChannelMach::ProcessIncomingMessage() {
       header,
       MACH_RCV_MSG | MACH_RCV_TIMEOUT |
           MACH_RCV_TRAILER_TYPE(MACH_MSG_TRAILER_FORMAT_0) |
-          MACH_RCV_TRAILER_ELEMENTS(MACH_RCV_TRAILER_AUDIT) | MACH_RCV_VOUCHER,
+          MACH_RCV_TRAILER_ELEMENTS(MACH_RCV_TRAILER_AUDIT)
+#if !defined(MOZ_IOS_LEGACY)  // vouchers are iOS 8
+          | MACH_RCV_VOUCHER
+#endif
+      ,
       0, header->msgh_size, receive_port_.get(), /* timeout */ 0,
       MACH_PORT_NULL);
   if (kr != KERN_SUCCESS) {
@@ -270,7 +274,11 @@ bool ChannelMach::ProcessIncomingMessage() {
   // Read out descriptors from the sent message.
   auto* msg_body = buf_helper.Next<mach_msg_body_t>();
   if ((msg_body->msgh_descriptor_count > 0) !=
+#if defined(MOZ_IOS_LEGACY)  // MACH_MSGH_BITS_IS_COMPLEX is in newer SDKs only
+      ((header->msgh_bits & MACH_MSGH_BITS_COMPLEX) != 0)) {
+#else
       MACH_MSGH_BITS_IS_COMPLEX(header->msgh_bits)) {
+#endif
     CHROMIUM_LOG(ERROR)
         << "expected msgh_descriptor_count to match MACH_MSGH_BITS_COMPLEX";
     return false;
@@ -360,11 +368,13 @@ bool ChannelMach::ProcessIncomingMessage() {
       mozilla::MakeUnique<Message>(payload.data(), payload.size());
 
   // Transfer ownership of the voucher port into the IPC::Message.
+#if !defined(MOZ_IOS_LEGACY)
   if (MACH_MSGH_BITS_VOUCHER(header->msgh_bits) == MACH_MSG_TYPE_MOVE_SEND) {
     message->mach_voucher_.reset(header->msgh_voucher_port);
     header->msgh_voucher_port = MACH_PORT_NULL;
     header->msgh_bits &= ~MACH_MSGH_BITS_VOUCHER_MASK;
   }
+#endif
 
   // Unwrap any fileports attached to this message into FDs. FDs are always
   // added after other mach port rights, so we can assume the last
@@ -725,6 +735,29 @@ bool ChannelMach::CreateRawPipe(ChannelHandle* server, ChannelHandle* client) {
 // static
 bool ChannelMach::CreateRawPipe(mozilla::UniqueMachReceiveRight* server,
                                 mozilla::UniqueMachSendRight* client) {
+#if defined(MOZ_IOS_LEGACY)
+  // mach_port_construct is iOS 7: allocate, add the send right and raise the
+  // queue limit the old way.
+  mach_port_t port = MACH_PORT_NULL;
+  kern_return_t kr =
+      mach_port_allocate(mach_task_self(), MACH_PORT_RIGHT_RECEIVE, &port);
+  if (kr == KERN_SUCCESS) {
+    kr = mach_port_insert_right(mach_task_self(), port, port,
+                                MACH_MSG_TYPE_MAKE_SEND);
+  }
+  if (kr == KERN_SUCCESS) {
+    mach_port_limits_t limits{};
+    limits.mpl_qlimit = MACH_PORT_QLIMIT_LARGE;
+    kr = mach_port_set_attributes(mach_task_self(), port, MACH_PORT_LIMITS_INFO,
+                                  (mach_port_info_t)&limits,
+                                  MACH_PORT_LIMITS_INFO_COUNT);
+  }
+  if (kr != KERN_SUCCESS) {
+    CHROMIUM_LOG(ERROR) << "mach_port_allocate failed: "
+                        << mach_error_string(kr);
+    return false;
+  }
+#else
   mach_port_options_t options{};
   options.flags = MPO_INSERT_SEND_RIGHT | MPO_QLIMIT;
   options.mpl.mpl_qlimit = MACH_PORT_QLIMIT_LARGE;
@@ -736,6 +769,7 @@ bool ChannelMach::CreateRawPipe(mozilla::UniqueMachReceiveRight* server,
                         << mach_error_string(kr);
     return false;
   }
+#endif
 
   // Within a single task, all references to the same port have the same name.
   // Thanks to `MPO_INSERT_SEND_RIGHT`, both a send and receive right were
