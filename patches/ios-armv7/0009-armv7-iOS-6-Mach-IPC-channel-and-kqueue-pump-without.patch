diff --git a/toolkit/components/processtools/ProcInfo.mm b/toolkit/components/processtools/ProcInfo.mm
index 8e5b6a4aa3..95d329b0aa 100644
--- a/toolkit/components/processtools/ProcInfo.mm
+++ b/toolkit/components/processtools/ProcInfo.mm
@@ -24,10 +24,38 @@ static void GetTimeBase(mach_timebase_info_data_t* timebase) {
 
 namespace mozilla {
 
+#if defined(MOZ_IOS_LEGACY)
+// iOS 4-7 have neither TASK_VM_INFO (phys_footprint) nor TASK_POWER_INFO;
+// TASK_BASIC_INFO gives resident size and CPU time.
+static bool LegacyTaskInfo(task_t aTask, uint64_t* aCpuNs, uint64_t* aResident) {
+  task_basic_info_data_t info;
+  mach_msg_type_number_t count = TASK_BASIC_INFO_COUNT;
+  if (task_info(aTask, TASK_BASIC_INFO, (task_info_t)&info, &count) !=
+      KERN_SUCCESS) {
+    return false;
+  }
+  if (aCpuNs) {
+    *aCpuNs = (uint64_t(info.user_time.seconds) + info.system_time.seconds) *
+                  PR_NSEC_PER_SEC +
+              (uint64_t(info.user_time.microseconds) +
+               info.system_time.microseconds) *
+                  PR_NSEC_PER_USEC;
+  }
+  if (aResident) {
+    *aResident = info.resident_size;
+  }
+  return true;
+}
+#endif
+
 nsresult GetCurrentProcessMemoryUsage(uint64_t* aResult) {
   if (!aResult) {
     return NS_ERROR_INVALID_ARG;
   }
+#if defined(MOZ_IOS_LEGACY)
+  return LegacyTaskInfo(mach_task_self(), nullptr, aResult) ? NS_OK
+                                                             : NS_ERROR_FAILURE;
+#else
   task_vm_info_data_t info;
   mach_msg_type_number_t count = TASK_VM_INFO_COUNT;
 
@@ -40,9 +68,18 @@ nsresult GetCurrentProcessMemoryUsage(uint64_t* aResult) {
   // phys_footprint matches Activity Monitor’s “Memory” column on macOS 10.11+
   *aResult = info.phys_footprint;
   return NS_OK;
+#endif
 }
 
 nsresult GetCpuTimeSinceProcessStartInMs(uint64_t* aResult) {
+#if defined(MOZ_IOS_LEGACY)
+  uint64_t ns;
+  if (!LegacyTaskInfo(mach_task_self(), &ns, nullptr)) {
+    return NS_ERROR_FAILURE;
+  }
+  *aResult = ns / PR_NSEC_PER_MSEC;
+  return NS_OK;
+#else
   task_power_info_data_t task_power_info;
   mach_msg_type_number_t count = TASK_POWER_INFO_COUNT;
   kern_return_t kr = task_info(mach_task_self(), TASK_POWER_INFO,
@@ -57,9 +94,13 @@ nsresult GetCpuTimeSinceProcessStartInMs(uint64_t* aResult) {
   *aResult = (task_power_info.total_user + task_power_info.total_system) *
              timebase.numer / timebase.denom / PR_NSEC_PER_MSEC;
   return NS_OK;
+#endif
 }
 
 nsresult GetGpuTimeSinceProcessStartInMs(uint64_t* aResult) {
+#if defined(MOZ_IOS_LEGACY)
+  return NS_ERROR_NOT_IMPLEMENTED;
+#else
   task_power_info_v2_data_t task_power_info;
   mach_msg_type_number_t count = TASK_POWER_INFO_V2_COUNT;
   kern_return_t kr = task_info(mach_task_self(), TASK_POWER_INFO_V2,
@@ -70,6 +111,7 @@ nsresult GetGpuTimeSinceProcessStartInMs(uint64_t* aResult) {
 
   *aResult = task_power_info.gpu_energy.task_gpu_utilisation / PR_NSEC_PER_MSEC;
   return NS_OK;
+#endif
 }
 
 int GetCycleTimeFrequencyMHz() { return 0; }
@@ -105,6 +147,16 @@ ProcInfoPromise::ResolveOrRejectValue GetProcInfoSync(
       selectedTask = request.childTask;
     }
 
+#if defined(MOZ_IOS_LEGACY)
+    uint64_t cpuNs, resident;
+    if (!LegacyTaskInfo(selectedTask, &cpuNs, &resident)) {
+      continue;
+    }
+    info.cpuTime = cpuNs;
+    info.memory = resident;
+    mach_msg_type_number_t count;
+    kern_return_t kr;
+#else
     task_power_info_data_t task_power_info;
     mach_msg_type_number_t count = TASK_POWER_INFO_COUNT;
     kern_return_t kr = task_info(selectedTask, TASK_POWER_INFO,
@@ -125,6 +177,7 @@ ProcInfoPromise::ResolveOrRejectValue GetProcInfoSync(
     kr = task_info(selectedTask, TASK_VM_INFO, (task_info_t)&task_vm_info,
                    &count);
     info.memory = kr == KERN_SUCCESS ? task_vm_info.phys_footprint : 0;
+#endif
 
     // Now getting threads info
 
