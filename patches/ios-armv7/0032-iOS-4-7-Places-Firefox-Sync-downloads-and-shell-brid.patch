diff --git a/uriloader/exthandler/uikit/nsOSHelperAppService.mm b/uriloader/exthandler/uikit/nsOSHelperAppService.mm
index 552dd81e84..df612a722d 100644
--- a/uriloader/exthandler/uikit/nsOSHelperAppService.mm
+++ b/uriloader/exthandler/uikit/nsOSHelperAppService.mm
@@ -3,6 +3,7 @@
  * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
 
 #include "nsOSHelperAppService.h"
+#include "nsMIMEInfoUIKit.h"
 
 nsOSHelperAppService::nsOSHelperAppService() : nsExternalHelperAppService() {}
 
@@ -44,7 +45,21 @@ NS_IMETHODIMP nsOSHelperAppService::GetMIMEInfoFromOS(
     nsIMIMEInfo** aMIMEInfo) {
   *aMIMEInfo = nullptr;
   *aFound = false;
+#ifdef MOZ_IOS_LEGACY
+  // No system handlers here: a plain MIME info that saves to disk, so that
+  // downloads go through Gecko's own helper app service.
+  RefPtr<nsMIMEInfoUIKit> info = new nsMIMEInfoUIKit(
+      aMIMEType.IsEmpty() ? "application/octet-stream"_ns : aMIMEType);
+  if (!aFileExt.IsEmpty()) {
+    info->AppendExtension(aFileExt);
+  }
+  info->SetPreferredAction(nsIMIMEInfo::saveToDisk);
+  info->SetAlwaysAskBeforeHandling(false);
+  info.forget(aMIMEInfo);
+  return NS_OK;
+#else
   return NS_ERROR_NOT_IMPLEMENTED;
+#endif
 }
 
 NS_IMETHODIMP
