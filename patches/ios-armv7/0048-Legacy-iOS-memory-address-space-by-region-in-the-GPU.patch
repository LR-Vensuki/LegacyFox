   glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
 }
 
+// The pass-through vertex shader for `slots` texture coordinates, made the
+// first time a program needs it: the compiler's memory is dear.
+static GLuint vertex_stage(GpuBackend* g, int slots) {
+  if (g->vs[slots]) return g->vs[slots];
+  std::string src = "attribute vec4 glsl_pos;\n";
+  char buf[96];
+  for (int i = 0; i < slots; i++) {
+    snprintf(buf, sizeof(buf),
+             "attribute vec4 glsl_a%d;\nvarying vec4 glsl_t%d;\n", i, i);
+    src += buf;
+  }
+  src += "void main() {\n gl_Position = glsl_pos;\n";
+  for (int i = 0; i < slots; i++) {
+    snprintf(buf, sizeof(buf), " glsl_t%d = glsl_a%d;\n", i, i);
+    src += buf;
+  }
+  src += "}\n";
+  g->vs[slots] = compile_shader(GL_VERTEX_SHADER, src.c_str(), "vertex stage");
+  return g->vs[slots];
+}
+
 static bool init_backend(GpuBackend* g) {
   const char* exts = (const char*)glGetString(GL_EXTENSIONS);
   g->red_ok = has_extension(exts, "GL_EXT_texture_rg");
@@ -340,23 +362,7 @@ static bool init_backend(GpuBackend* g) {
   glGetIntegerv(GL_MAX_TEXTURE_SIZE, &max);
   if (max > 0) g->max_texture = max;
 
-  for (int slots = 1; slots <= 8; slots++) {
-    std::string src = "attribute vec4 glsl_pos;\n";
-    char buf[96];
-    for (int i = 0; i < slots; i++) {
-      snprintf(buf, sizeof(buf),
-               "attribute vec4 glsl_a%d;\nvarying vec4 glsl_t%d;\n", i, i);
-      src += buf;
-    }
-    src += "void main() {\n gl_Position = glsl_pos;\n";
-    for (int i = 0; i < slots; i++) {
-      snprintf(buf, sizeof(buf), " glsl_t%d = glsl_a%d;\n", i, i);
-      src += buf;
-    }
-    src += "}\n";
-    g->vs[slots] = compile_shader(GL_VERTEX_SHADER, src.c_str(), "vertex stage");
-    if (!g->vs[slots]) return false;
-  }
+  if (!vertex_stage(g, 1)) return false;
   // Pixels the CPU shaded, placed by the GPU: texture coordinate (u w, v w,
   // 0, w), divided here so that perspective quads line up.
   GLuint copy_fs = compile_shader(
@@ -798,10 +804,15 @@ static GpuProgram* program_for(GpuBackend* g, const GpuProgramInfo* info) {
   GpuProgram p;
   GLuint fs = compile_shader(GL_FRAGMENT_SHADER, (const char*)info->ps,
                              info->name);
-  if (fs) {
-    p.prog = link_program(g->vs[info->slots], fs, info->slots, info->name);
+  GLuint vs = vertex_stage(g, info->slots);
+  if (fs && vs) {
+    p.prog = link_program(vs, fs, info->slots, info->name);
     glDeleteShader(fs);
   }
+  // The compiler's working memory goes back: on a 32-bit device the address
+  // space it leaves reserved in malloc's regions is what runs out first.
+  glReleaseShaderCompiler();
+  malloc_zone_pressure_relief(nullptr, 0);
   if (!p.prog) {
     g->refused[info] = true;
     return nullptr;
diff --git a/memory/build/Constants.h b/memory/build/Constants.h
index 9f79d8ac05..ec69a2a6a6 100644
--- a/memory/build/Constants.h
+++ b/memory/build/Constants.h
@@ -121,6 +121,12 @@ constexpr size_t kCacheLineMask = kCacheLineSize - 1;
 
 // Recycle at most 128 MiB of chunks. This means we retain at most
 // 6.25% of the process address space on a 32-bit OS for later use.
+#if defined(MOZ_IOS_LEGACY)
+// A 32-bit iOS process has under 1 GiB of address space left once the
+// shared cache and the binary are mapped; recycled chunks hold on to it.
+static constexpr size_t gRecycleLimit = 16_MiB;
+#else
 static constexpr size_t gRecycleLimit = 128_MiB;
+#endif
 
 #endif /* ! CONSTANTS_H */
