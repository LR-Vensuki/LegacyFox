From d1ec10ec6c45716462b40aba887e133af9314d28 Mon Sep 17 00:00:00 2001
From: LR-Vensuki <260785366+LR-Vensuki@users.noreply.github.com>
Date: Tue, 27 Oct 2026 11:45:10 +0300
Subject: [PATCH] Legacy iOS memory: address space by region in the GPU stats,
 smaller chunk recycling, shader compiler memory released

LF_SWGL_GPU_STATS=1 also logs the address space by kernel tag and the
regions of 8 MB or more. mozjemalloc keeps at most 16 MiB of recycled
chunks on legacy iOS (128 MiB elsewhere). The GLES2 path compiles its
vertex stages as programs need them and releases the shader compiler
after each program.
---
 .../RenderCompositorNative.cpp                | 59 +++++++++++++++++++
 .../RenderCompositorNative.h                  |  1 +
 gfx/wr/swgl/src/gl.cc                         |  1 +
 gfx/wr/swgl/src/gpu_gles2.h                   | 49 +++++++++------
 memory/build/Constants.h                      |  6 ++
 5 files changed, 97 insertions(+), 19 deletions(-)

diff --git a/gfx/webrender_bindings/RenderCompositorNative.cpp b/gfx/webrender_bindings/RenderCompositorNative.cpp
index a509f1a76f..83b2b63990 100644
--- a/gfx/webrender_bindings/RenderCompositorNative.cpp
+++ b/gfx/webrender_bindings/RenderCompositorNative.cpp
@@ -679,6 +679,9 @@ bool RenderCompositorNativeSWGL::MakeCurrent() {
     SwglGpuDescribe(describe, sizeof(describe));
     printf_stderr("LegacyFox: SWGL pixel shading on the GPU %s: %s\n",
                   mGpuAttached ? "on" : "refused", describe);
+    if (getenv("LF_SWGL_GPU_STATS")) {
+      LogAddressSpace();
+    }
     if (!mGpuAttached) {
       SwglGpuEAGLDestroy(mGpu);
       mGpu = nullptr;
@@ -712,8 +715,64 @@ void RenderCompositorNativeSWGL::DoFlush() {
         s[0], s[1], s[2], s[3], s[4], s[5], s[6], s[7], m[0], m[1], m[2], m[3],
         m[4], unsigned(info.resident_size >> 20),
         unsigned(info.virtual_size >> 20));
+    if (mGpuFrames % 50 == 0) {
+      LogAddressSpace();
+    }
   }
 }
+
+// Where the address space goes, by the kernel's tag of each region (malloc,
+// IOKit, IOSurface...), largest first: a 32-bit process runs out of address
+// space long before it runs out of memory.
+void RenderCompositorNativeSWGL::LogAddressSpace() {
+  struct Tag {
+    unsigned tag;
+    uint64_t mapped, resident;
+  };
+  std::vector<Tag> tags;
+  nsCString large;
+  vm_address_t address = 0;
+  uint64_t total = 0;
+  while (true) {
+    vm_size_t size = 0;
+    natural_t depth = 0;
+    vm_region_submap_info_data_64_t region;
+    mach_msg_type_number_t count = VM_REGION_SUBMAP_INFO_COUNT_64;
+    if (vm_region_recurse_64(mach_task_self(), &address, &size, &depth,
+                             (vm_region_info_64_t)&region,
+                             &count) != KERN_SUCCESS) {
+      break;
+    }
+    auto it = std::find_if(tags.begin(), tags.end(), [&](const Tag& t) {
+      return t.tag == region.user_tag;
+    });
+    if (it == tags.end()) {
+      tags.push_back({region.user_tag, 0, 0});
+      it = tags.end() - 1;
+    }
+    if (size >= (8 << 20)) {
+      large.AppendPrintf(" %x+%uM(t%u r%u)", unsigned(address),
+                         unsigned(size >> 20), region.user_tag,
+                         unsigned((uint64_t(region.pages_resident) *
+                                   vm_page_size) >> 20));
+    }
+    it->mapped += size;
+    it->resident += uint64_t(region.pages_resident) * vm_page_size;
+    total += size;
+    address += size;
+  }
+  std::sort(tags.begin(), tags.end(),
+            [](const Tag& a, const Tag& b) { return a.mapped > b.mapped; });
+  nsCString line;
+  line.AppendPrintf("LegacyFox: address space %u MB by tag:",
+                    unsigned(total >> 20));
+  for (size_t i = 0; i < tags.size() && i < 14; i++) {
+    line.AppendPrintf(" %u=%u/%u", tags[i].tag, unsigned(tags[i].mapped >> 20),
+                      unsigned(tags[i].resident >> 20));
+  }
+  printf_stderr("%s\n", line.get());
+  printf_stderr("LegacyFox: regions of 8 MB or more:%s\n", large.get());
+}
 #endif
 
