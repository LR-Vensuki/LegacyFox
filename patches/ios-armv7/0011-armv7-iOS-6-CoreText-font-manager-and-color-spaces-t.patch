diff --git a/ipc/chromium/src/base/message_pump_kqueue.cc b/ipc/chromium/src/base/message_pump_kqueue.cc
index 46c1d5363a..6dd2c27ce0 100644
--- a/ipc/chromium/src/base/message_pump_kqueue.cc
+++ b/ipc/chromium/src/base/message_pump_kqueue.cc
@@ -18,6 +18,10 @@
 
 namespace base {
 
+#if defined(MOZ_IOS_LEGACY) && !defined(KEVENT_FLAG_IMMEDIATE)
+#  define KEVENT_FLAG_IMMEDIATE 0x001
+#endif
+
 namespace {
 
 // On iOS, the normal `kevent64` method is blocked by the content process
@@ -26,6 +30,11 @@ static int platform_kevent64(int fd, const kevent64_s* changelist, int nchanges,
                              kevent64_s* eventlist, int nevents, int flags) {
 #if defined(XP_IOS) && !defined(MOZ_IOS_LEGACY)
   return be_kevent64(fd, changelist, nchanges, eventlist, nevents, flags);
+#elif defined(MOZ_IOS_LEGACY)
+  // The iOS 6 SDK has no KEVENT_FLAG_IMMEDIATE: a zero timeout polls the same.
+  static const struct timespec kZero = {0, 0};
+  return kevent64(fd, changelist, nchanges, eventlist, nevents, 0,
+                  flags ? &kZero : nullptr);
 #else
   return kevent64(fd, changelist, nchanges, eventlist, nevents, flags, nullptr);
 #endif
