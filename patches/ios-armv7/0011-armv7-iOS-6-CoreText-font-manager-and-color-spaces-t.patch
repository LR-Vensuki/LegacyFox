diff --git a/dom/media/platforms/apple/AppleDecoderModule.cpp b/dom/media/platforms/apple/AppleDecoderModule.cpp
index 27c25b050d..43268e578e 100644
--- a/dom/media/platforms/apple/AppleDecoderModule.cpp
+++ b/dom/media/platforms/apple/AppleDecoderModule.cpp
@@ -38,7 +38,11 @@ static inline CMVideoCodecType GetCMVideoCodecType(const MediaCodec& aCodec) {
     case MediaCodec::AV1:
       return kCMVideoCodecType_AV1;
     case MediaCodec::VP9:
+#if defined(MOZ_IOS_LEGACY)  // not in the iOS 6.1 SDK
+      return static_cast<CMVideoCodecType>('vp09');
+#else
       return kCMVideoCodecType_VP9;
+#endif
     case MediaCodec::HEVC:
       return kCMVideoCodecType_HEVC;
     default:
@@ -238,9 +242,15 @@ bool AppleDecoderModule::CanCreateHWDecoder(const MediaCodec& aCodec) {
     return false;
   }
 
+#if defined(MOZ_IOS_LEGACY)
+  // VTIsHardwareDecodeSupported is iOS 11. A4-A6 decode H.264 in hardware
+  // and nothing else.
+  return aCodec == MediaCodec::H264;
+#else
   if (!VTIsHardwareDecodeSupported(GetCMVideoCodecType(aCodec))) {
     return false;
   }
+#endif
 
   // H264 hardware decoding has been supported since macOS 10.6 on most Intel
   // GPUs (Sandy Bridge and later, 2011). If VTIsHardwareDecodeSupported is
