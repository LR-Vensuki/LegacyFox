From b430db189aeaa4a183f1aa7923969733f6cd6362 Mon Sep 17 00:00:00 2001
From: LR-Vensuki <260785366+LR-Vensuki@users.noreply.github.com>
Date: Wed, 14 Oct 2026 00:13:06 +0300
Subject: [PATCH 24/42] CoreText font list: visible fallback for iOS 6's hidden
 UI font family

---
 gfx/thebes/CoreTextFontList.cpp                | 18 ++++++++++++++++++
 .../rust/atomic_refcell/.cargo-checksum.json   |  2 +-
 third_party/rust/atomic_refcell/src/lib.rs     |  4 ++--
 3 files changed, 21 insertions(+), 3 deletions(-)

diff --git a/gfx/thebes/CoreTextFontList.cpp b/gfx/thebes/CoreTextFontList.cpp
index 98454ae471..2c3edf3895 100644
--- a/gfx/thebes/CoreTextFontList.cpp
+++ b/gfx/thebes/CoreTextFontList.cpp
@@ -1925,7 +1925,25 @@ FontFamily CoreTextFontList::GetDefaultFontForPlatform(
   nsAutoString familyName;
   GetStringForCFString(name, familyName);
 
+#if defined(MOZ_IOS_LEGACY)
+  // The iOS 4-7 UI font is a hidden family (".Helvetica NeueUI") that the
+  // font list does not show; fall back to the faces it is drawn from.
+  if (FontFamily family = FindFamily(aFontVisibilityProvider,
+                                     NS_ConvertUTF16toUTF8(familyName));
+      !family.IsNull()) {
+    return family;
+  }
+  for (const char* fallback : {"Helvetica Neue", "Helvetica", "Arial"}) {
+    if (FontFamily family =
+            FindFamily(aFontVisibilityProvider, nsDependentCString(fallback));
+        !family.IsNull()) {
+      return family;
+    }
+  }
+  return FontFamily();
+#else
   return FindFamily(aFontVisibilityProvider, NS_ConvertUTF16toUTF8(familyName));
+#endif
 }
 
