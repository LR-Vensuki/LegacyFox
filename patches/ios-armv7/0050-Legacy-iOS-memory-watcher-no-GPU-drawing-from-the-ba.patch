diff --git a/widget/uikit/nsAppShell.mm b/widget/uikit/nsAppShell.mm
index ceef771a0f..656e8a7c3a 100644
--- a/widget/uikit/nsAppShell.mm
+++ b/widget/uikit/nsAppShell.mm
@@ -43,6 +43,115 @@ nsAppShell* nsAppShell::gAppShell = NULL;
 
 static void ApplicationWillTerminate(bool aCallExit);
 
+#if defined(MOZ_IOS_LEGACY)
+#  include <dispatch/dispatch.h>
+#  include <mach/mach.h>
+#  include <sys/sysctl.h>
+#  include <algorithm>
+#  include "mozilla/TimeStamp.h"
+
+namespace mozilla::wr {
+void SetLegacyAppInBackground(bool aBackground);
+}
+
+// A 32-bit iOS 4-7 app has the 768 MB below the shared cache (0x30000000)
+// for itself. Long before memory runs out, malloc or the GPU driver find no
+// hole for a large block there and the app crashes ("can't allocate
+// region"). Every 2 s a background thread measures the free part; when it
+// gets small, or the memory iOS has left for all apps does (it kills the
+// app in front without a warning when that runs out), Gecko is told memory
+// is low (caches, JIT code and empty GC chunks go back), and that it is fine
+// again once there is room. With almost nothing left the embedding app is
+// told (LegacyFoxMemoryCritical): it can drop the page before iOS kills it.
+static void WatchAddressSpace() {
+  static dispatch_source_t timer = dispatch_source_create(
+      DISPATCH_SOURCE_TYPE_TIMER, 0, 0,
+      dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_LOW, 0));
+  static bool low = false;
+  static TimeStamp lowSince, criticalSince;
+  dispatch_source_set_timer(timer,
+                            dispatch_time(DISPATCH_TIME_NOW, 2 * NSEC_PER_SEC),
+                            2 * NSEC_PER_SEC, NSEC_PER_SEC / 2);
+  dispatch_source_set_event_handler(timer, ^{
+    const vm_address_t end = 0x30000000;
+    vm_address_t address = 0;
+    vm_size_t free = 0, largest = 0;
+    while (address < end) {
+      vm_address_t region = address;
+      vm_size_t size = 0;
+      natural_t depth = 0;
+      vm_region_submap_info_data_64_t info;
+      mach_msg_type_number_t count = VM_REGION_SUBMAP_INFO_COUNT_64;
+      if (vm_region_recurse_64(mach_task_self(), &region, &size, &depth,
+                               (vm_region_info_64_t)&info,
+                               &count) != KERN_SUCCESS ||
+          region > end) {
+        region = end;
+        size = 0;
+      }
+      if (region > address) {
+        free += region - address;
+        largest = std::max(largest, region - address);
+      }
+      if (!size) {
+        break;
+      }
+      address = region + size;
+    }
+    // The share of memory iOS has left, in percent.
+    int level = 100;
+    size_t len = sizeof(level);
+    sysctlbyname("kern.memorystatus_level", &level, &len, nullptr, 0);
+    static int loggedLevel = 0;
+    static const bool stats = getenv("LF_SWGL_GPU_STATS");
+    if (stats && std::abs(level - loggedLevel) >= 3) {
+      fprintf(stderr, "LegacyFox: memory level %d%%, address space %u MB free\n",
+              level, unsigned(free >> 20));
+      loggedLevel = level;
+    }
+    TimeStamp now = TimeStamp::Now();
+    bool tight =
+        free < (112u << 20) || largest < (40u << 20) || level < 20;
+    bool roomy =
+        free > (160u << 20) && largest > (64u << 20) && level > 30;
+    // Again every 30 s while it stays tight, every 10 s near the end.
+    if (tight &&
+        (!low || (now - lowSince).ToSeconds() > (level < 12 ? 10 : 30))) {
+      fprintf(stderr,
+              "LegacyFox: memory low: address space %u MB free, largest hole "
+              "%u MB, memory level %d%%\n",
+              unsigned(free >> 20), unsigned(largest >> 20), level);
+      low = true;
+      lowSince = now;
+      NS_NotifyOfMemoryPressure(MemoryPressureState::LowMemory);
+    } else if (low && roomy) {
+      fprintf(stderr, "LegacyFox: memory fine again: %u MB free, level %d%%\n",
+              unsigned(free >> 20), level);
+      low = false;
+      NS_NotifyOfMemoryPressure(MemoryPressureState::NoPressure);
+    }
+    // iOS sends its last warning near 10% and kills a few points lower; the
+    // GPU driver crashes once it finds no hole for its 16 MB blocks.
+    bool critical =
+        level <= 10 || free < (64u << 20) || largest < (24u << 20);
+    if (critical &&
+        (criticalSince.IsNull() || (now - criticalSince).ToSeconds() > 20)) {
+      fprintf(stderr,
+              "LegacyFox: memory critical: level %d%%, address space %u MB "
+              "free, largest hole %u MB\n",
+              level, unsigned(free >> 20), unsigned(largest >> 20));
+      criticalSince = now;
+      dispatch_async(dispatch_get_main_queue(), ^{
+        [[NSNotificationCenter defaultCenter]
+            postNotificationName:@"LegacyFoxMemoryCritical"
+                          object:nil];
+      });
+    }
+  });
+  dispatch_resume(timer);
+}
+#endif
