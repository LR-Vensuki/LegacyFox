+          "LegacyFox: %u frames in %.0f ms (%.1f fps), drawing %.0f ms (%.0f "
+          "ms a frame), %.1f Mpx drawn\n",
+          mStatsFrames, elapsed, mStatsFrames * 1000 / elapsed,
+          mStatsDrawingMs, mStatsDrawingMs / mStatsFrames,
+          mStatsPixels / 1e6);
+      mStatsStart = now;
+      mStatsFrames = 0;
+      mStatsDrawingMs = 0;
+      mStatsPixels = 0;
+    }
+  }
   if (stats && ++mGpuFrames % (mGpuAttached ? 1 : 10) == 0) {
     uint32_t s[8], m[5];
     task_basic_info_data_t info = {};
@@ -772,6 +832,23 @@ void RenderCompositorNativeSWGL::LogAddressSpace() {
   }
   printf_stderr("%s\n", line.get());
   printf_stderr("LegacyFox: regions of 8 MB or more:%s\n", large.get());
+  // Who holds malloc's regions: the system's zones, by name.
+  vm_address_t* zones = nullptr;
+  unsigned zoneCount = 0;
+  nsCString zoneLine;
+  if (malloc_get_all_zones(mach_task_self(), nullptr, &zones, &zoneCount) ==
