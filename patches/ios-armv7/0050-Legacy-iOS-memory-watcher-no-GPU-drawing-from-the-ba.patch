 .../RenderCompositorNative.h                  |  19 +++
 gfx/wr/swgl/src/gpu_gles2.h                   |   5 +
 widget/uikit/nsAppShell.mm                    | 127 ++++++++++++++++++
 4 files changed, 229 insertions(+)

