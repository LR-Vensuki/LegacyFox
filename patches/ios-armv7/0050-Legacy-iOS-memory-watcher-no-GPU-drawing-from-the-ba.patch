+    TimeStamp now = TimeStamp::Now();
+    if (mStatsStart.IsNull()) {
+      mStatsStart = now;
+    }
+    mStatsFrames++;
+    mStatsDrawingMs += (now - mBeginFrameTimeStamp).ToMilliseconds();
+    double elapsed = (now - mStatsStart).ToMilliseconds();
+    if (elapsed >= 2000) {
