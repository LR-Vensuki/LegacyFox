+      malloc_zone_statistics(zone, &st);
+      zoneLine.AppendPrintf(" %s=%u/%u", zone->zone_name ? zone->zone_name : "?",
+                            unsigned(st.size_allocated >> 20),
+                            unsigned(st.size_in_use >> 20));
+    }
+  }
+  printf_stderr("LegacyFox: malloc zones (MB reserved/in use):%s\n",
+                zoneLine.get());
 }
 #endif
 
