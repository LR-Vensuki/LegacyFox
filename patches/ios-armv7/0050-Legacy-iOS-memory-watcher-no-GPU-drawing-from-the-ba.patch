+#if defined(MOZ_IOS_LEGACY)
+static Atomic<bool> sAppInBackground(false);
+
+void SetLegacyAppInBackground(bool aBackground) {
+  MOZ_ASSERT(NS_IsMainThread());
+  sAppInBackground = aBackground;
+  nsCOMPtr<nsIThread> thread = RenderThread::GetRenderThread();
+  if (!aBackground || !thread) {
+    return;
+  }
+  struct Done {
+    Monitor mMonitor{"SetLegacyAppInBackground"};
+    bool mDone MOZ_GUARDED_BY(mMonitor) = false;
+  };
+  auto done = std::make_shared<Done>();
+  thread->Dispatch(NS_NewRunnableFunction("SetLegacyAppInBackground", [done] {
+    MonitorAutoLock lock(done->mMonitor);
+    done->mDone = true;
+    lock.Notify();
+  }));
+  MonitorAutoLock lock(done->mMonitor);
+  TimeStamp end = TimeStamp::Now() + TimeDuration::FromSeconds(2);
+  while (!done->mDone && TimeStamp::Now() < end) {
+    lock.Wait(end - TimeStamp::Now());
+  }
+}
+
+// Only the GPU path stops: the CPU one keeps drawing behind the lock screen,
+// for the developer runs that start the app there.
+bool RenderCompositorNativeSWGL::IsPaused() { return mGpu && sAppInBackground; }
+#endif
