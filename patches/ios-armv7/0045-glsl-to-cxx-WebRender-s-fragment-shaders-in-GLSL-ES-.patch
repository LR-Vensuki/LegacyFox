+/// An HLSL type name as GLSL ES 1.0 spells it.
+fn essl_type(t: &str) -> String {
+    let base = |b: &str| match b {
+        "float" => "vec",
+        "int" => "ivec",
+        "bool" => "bvec",
+        _ => "",
+    };
+    for b in ["float", "int", "bool"] {
+        if let Some(rest) = t.strip_prefix(b) {
+            if rest.len() == 1 && rest.chars().all(|c| ('2'..='4').contains(&c)) {
+                return format!("{}{}", base(b), rest);
+            }
+            if rest.len() == 3 && b == "float" && rest.as_bytes()[0] == rest.as_bytes()[2] {
+                return format!("mat{}", &rest[..1]);
+            }
+        }
+    }
+    t.to_string()
 }
 
