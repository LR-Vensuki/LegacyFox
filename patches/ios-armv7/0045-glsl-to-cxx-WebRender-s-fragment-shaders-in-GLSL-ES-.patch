+/// GLSL ES's main: the varyings come in as texture coordinates, packed as
+/// for 9_3, and leave as gl_FragColor.
+fn essl_entry(
+    em: &mut Emitter,
+    layout: &Layout,
+    statics: &[(hir::SymRef, hir::Type)],
+    clip_distance: bool,
+) {
+    for i in 0..layout.slots {
+        em.line(&format!("varying vec4 glsl_t{};", i));
+    }
+    em.line("void main()");
+    em.line("{");
+    em.indent += 1;
+    let comps = ["x", "y", "z", "w"];
+    let at = |o: usize| format!("glsl_t{}.{}", o / 4, comps[o % 4]);
+    if let Some(o) = layout.flat_coord_offset {
+        let texels = (layout.texture_floats + 3) / 4;
+        em.line(&format!("vec2 glsl_fuv = vec2({}, {});", at(o), at(o + 1)));
+        for k in 0..texels {
+            em.line(&format!(
+                "vec4 glsl_f{0} = texture2D(glsl_flat, glsl_fuv + vec2({0}.0 * glsl_flat_size.z, 0.0));",
+                k
+            ));
+        }
+    }
+    for v in layout.varyings.clone() {
+        let tn = em.type_kind(v.kind);
+        let parts: Vec<String> = (0..v.floats)
+            .map(|k| {
+                let o = v.offset + k;
+                let src = if v.in_texture {
+                    format!("glsl_f{}.{}", o / 4, comps[o % 4])
+                } else {
+                    at(o)
+                };
+                if v.integer {
+                    format!("floor({} + 0.5)", src)
+                } else if v.kind.is_bool() {
+                    format!("({} > 0.5)", src)
+                } else {
+                    src
+                }
+            })
+            .collect();
+        em.line(&format!("{} = {}({});", v.name, tn, parts.join(", ")));
+    }
+    if let Some(o) = layout.fragcoord_offset {
+        em.line(&format!("glsl_FragCoord = vec4({}, {}, 0.0, 1.0);", at(o), at(o + 1)));
+    }
+    if clip_distance {
+        em.uses_discard = true;
+        em.line("if (any(lessThan(swgl_ClipDistance, vec4(0.0)))) discard;");
+    }
+    em.line("glsl_main();");
+    let out_name = statics
+        .iter()
+        .map(|(sym, _)| em.sym_name(*sym))
+        .find(|n| n == "oFragColor")
+        .unwrap_or_else(|| "oFragColor".into());
+    em.line(&format!("gl_FragColor = {};", out_name));
+    em.indent -= 1;
+    em.line("}");
