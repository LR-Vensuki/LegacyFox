+/// The fragment shader's source goes where 9_3's bytecode would, with its
+/// terminating zero. Loops are unrolled to the first limit; the device
+/// compiler sees nothing longer.
+fn write_essl_header(
+    out_dir: &str,
+    shader: &str,
+    gpu: Option<(Vec<(usize, String)>, glsl_to_cxx::hlsl::Layout)>,
+    errors: &[String],
+) -> bool {
+    let path = format!("{out_dir}/{shader}_gpu.h");
+    let (sources, layout) = match gpu {
+        Some(g) => g,
+        None => {
+            println!("cargo:warning=swgl: {shader} stays on the CPU: {}", errors.join(" | "));
+            let stub =
+                format!("static const GpuProgramInfo* {shader}_gpu_info() {{ return nullptr; }}\n");
+            std::fs::write(path, stub).unwrap();
+            return false;
+        }
+    };
+    let (limit, src) = &sources[0];
+    std::fs::write(format!("{out_dir}/{shader}.essl.frag"), src).unwrap();
+    let mut bytes = src.clone().into_bytes();
+    bytes.push(0);
+    std::fs::write(path, gpu_info_header(shader, &bytes, &layout, *limit)).unwrap();
+    true
