From d38f5e6c3f18ce46f4da073bf8ddbc298770a60e Mon Sep 17 00:00:00 2001
From: LR-Vensuki <260785366+LR-Vensuki@users.noreply.github.com>
Date: Fri, 9 Oct 2026 02:14:49 +0300
Subject: [PATCH 23/42] RustMozCrash prints the panic on armv7 iOS (no crash
 reporter)

---
 mozglue/static/rust/wrappers.cpp | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/mozglue/static/rust/wrappers.cpp b/mozglue/static/rust/wrappers.cpp
index 8938fef04c..4957198bb1 100644
--- a/mozglue/static/rust/wrappers.cpp
+++ b/mozglue/static/rust/wrappers.cpp
@@ -6,6 +6,7 @@
 // used in the MFBT headers included further below. We use js-confdefs.h
 // instead of mozilla-config.h because the latter is not present in
 // spidermonkey standalone builds while the former is always present.
+#include <stdio.h>
 #include "js-confdefs.h"
 #include "mozilla/Assertions.h"
 #include "mozilla/Types.h"
@@ -14,6 +15,11 @@
 // MOZ_Crash wrapper for use by rust, since MOZ_Crash is an inline function.
 extern "C" void RustMozCrash(const char* aFilename, int aLine,
                              const char* aReason) {
+#if defined(MOZ_IOS_LEGACY)
+  // No crash reporter on iOS 4-7: say what panicked, or nobody ever knows.
+  fprintf(stderr, "Rust panic: %s at %s:%d\n", aReason, aFilename, aLine);
+  fflush(stderr);
+#endif
   MOZ_Crash(aFilename, aLine, aReason);
 }
 
