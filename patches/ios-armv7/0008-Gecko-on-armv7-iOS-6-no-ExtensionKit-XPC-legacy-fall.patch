diff --git a/gfx/skia/skia/src/utils/mac/SkCTFont.h b/gfx/skia/skia/src/utils/mac/SkCTFont.h
index ef18938b2b..a4c5609fe8 100644
--- a/gfx/skia/skia/src/utils/mac/SkCTFont.h
+++ b/gfx/skia/skia/src/utils/mac/SkCTFont.h
@@ -19,6 +19,35 @@
 #include <CoreGraphics/CoreGraphics.h>
 #endif
 
+#if defined(SK_BUILD_FOR_IOS) && defined(MOZ_IOS_LEGACY)
+// LegacyFox, iOS 4-7: CoreText calls from iOS 13 done with what iOS 4 has.
+#include <CoreText/CoreText.h>
+static inline CTFontDescriptorRef SkLegacyCreateFontDescriptorFromData(CFDataRef data) {
+    CGDataProviderRef provider = CGDataProviderCreateWithCFData(data);
+    if (!provider) {
+        return nullptr;
+    }
+    CGFontRef cgFont = CGFontCreateWithDataProvider(provider);
+    CGDataProviderRelease(provider);
+    if (!cgFont) {
+        return nullptr;
+    }
+    // A descriptor only finds the font again by name once it is registered.
+    CTFontManagerRegisterGraphicsFont(cgFont, nullptr);
+    CTFontRef font = CTFontCreateWithGraphicsFont(cgFont, 0, nullptr, nullptr);
+    CGFontRelease(cgFont);
+    if (!font) {
+        return nullptr;
+    }
+    CTFontDescriptorRef desc = CTFontCopyFontDescriptor(font);
+    CFRelease(font);
+    return desc;
+}
+#define CTFontManagerCreateFontDescriptorFromData SkLegacyCreateFontDescriptorFromData
+#define CTFontCreateForStringWithLanguage(font, string, range, language) \
+    CTFontCreateForString(font, string, range)
+#endif
+
 enum class SkCTFontSmoothBehavior {
     none, // SmoothFonts produces no effect.
     some, // SmoothFonts produces some effect, but not subpixel coverage.
