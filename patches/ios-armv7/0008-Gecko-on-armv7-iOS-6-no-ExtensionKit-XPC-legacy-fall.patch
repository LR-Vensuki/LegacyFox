                                  /* out */ bool& aReauthenticated,
                                  /* out */ bool& aIsBlankPassword) {
+#if defined(MOZ_IOS_LEGACY)
+  // LocalAuthentication came with iOS 8. Like an account without a passcode:
+  // the passwords screen in LegacyFox's own UI does the asking.
+  aReauthenticated = true;
