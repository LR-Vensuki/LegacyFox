From 717a0f68354ecc53591a4f21889bbdaff5870eb6 Mon Sep 17 00:00:00 2001
From: LR-Vensuki <260785366+LR-Vensuki@users.noreply.github.com>
Date: Wed, 14 Oct 2026 23:19:49 +0300
Subject: [PATCH 39/42] Sync on iOS 4-7: a device name (the shell's, or a
 fallback without accounts.ftl)

---
 mobile/shared/modules/geckoview/LegacyFoxSync.sys.mjs | 7 +++++++
 services/fxaccounts/FxAccountsDevice.sys.mjs          | 4 +++-
 2 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/mobile/shared/modules/geckoview/LegacyFoxSync.sys.mjs b/mobile/shared/modules/geckoview/LegacyFoxSync.sys.mjs
index 4ea572e0ae..a854bb4eb5 100644
--- a/mobile/shared/modules/geckoview/LegacyFoxSync.sys.mjs
+++ b/mobile/shared/modules/geckoview/LegacyFoxSync.sys.mjs
@@ -65,6 +65,13 @@ export const LegacyFoxSync = {
   async onEvent(aEvent, aData, aCallback) {
     debug`onEvent ${aEvent}`;
     try {
+      // The shell names this device after the iPad or iPhone it runs on, as
+      // others see it in their Firefox; a name the user set stays.
+      const name = aData?.deviceName;
+      const PREF = "identity.fxaccounts.account.device.name";
+      if (name && !Services.prefs.prefHasUserValue(PREF)) {
+        Services.prefs.setStringPref(PREF, name);
+      }
       startSync();
       switch (aEvent) {
         case "LegacyFox:Sync:State":
diff --git a/services/fxaccounts/FxAccountsDevice.sys.mjs b/services/fxaccounts/FxAccountsDevice.sys.mjs
index d38f26be6c..c0c40e757e 100644
--- a/services/fxaccounts/FxAccountsDevice.sys.mjs
+++ b/services/fxaccounts/FxAccountsDevice.sys.mjs
@@ -119,7 +119,9 @@ export class FxAccountsDevice {
       true
     );
     return sanitizeDeviceName(
-      l10n.formatValueSync("account-client-name", { user, system })
+      l10n.formatValueSync("account-client-name", { user, system }) ??
+        // Builds without services/accounts.ftl (LegacyFox on iOS).
+        `${Services.appinfo.name} (${system})`
     );
   }
 
-- 
