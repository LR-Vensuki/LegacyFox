+                             sizeof(swgl_gpu_vs1),
+                             sizeof(swgl_gpu_vs2),
+                             sizeof(swgl_gpu_vs3),
+                             sizeof(swgl_gpu_vs4),
+                             sizeof(swgl_gpu_vs5),
+                             sizeof(swgl_gpu_vs6),
+                             sizeof(swgl_gpu_vs7),
+                             sizeof(swgl_gpu_vs8)};
