# mozconfig for LegacyFox: Gecko for armv7 iOS 4-7, single-process, JIT.
#
# It follows mozconfig.arm-uwp-browser of gecko-w10m section by section and
# shares its toolchain part with mozconfig.js-armv7-ios, which builds.
# The project is mozilla-central's iOS port (mobile/ios, widget/uikit),
# brought down to armv7 and the iOS 6.1 SDK.

# ---- Target -----------------------------------------------------------------
ac_add_options --enable-project=mobile/ios
ac_add_options --target=armv7-apple-ios
mk_add_options MOZ_OBJDIR=${LEGACYFOX_OBJ:-$HOME/lf-obj}
ac_add_options --build-backends=RecursiveMake,FasterMake

# iPhoneOS6.1.sdk from theos, linked against iOS 4.0 and up.
ac_add_options --with-ios-sdk=${LEGACYFOX_SDK:-$HOME/theos/sdks/iPhoneOS6.1.sdk}
export IPHONEOS_DEPLOYMENT_TARGET=${LEGACYFOX_IOS_MIN:-4.0}

# ---- Compiler -----------------------------------------------------------------
# The system clang (21) compiles, ld64 from theos links. Code is generated for
# iOS 9 because clang allows thread_local on 32-bit ARM only from there;
# -femulated-tls turns it into __emutls_get_address calls (from theos'
# libclang_rt.ios.a) that work on any iOS, and the link targets iOS 4.0.
# libc++ 21 is linked statically (tools/build-libcxx.sh); what iOS 4-7 lacks
# comes from compat/ (docs: tools/cxx/README.md).
LF_TC=${LEGACYFOX_TC:-$HOME/theos/toolchain/linux/iphone/bin}
LF_CACHE=${LEGACYFOX_CACHE:-$HOME/.cache/legacyfox}
LF_COMPAT=${LEGACYFOX_COMPAT:-$topsrcdir/../../compat}
LF_RT=$LF_TC/../lib/clang/13.0.0/lib/darwin/libclang_rt.ios.a
# Sysroot and linker go in CC itself: NSS's gyp files and the linker check run
# ${CC} on their own. -B finds ld64 through a directory holding only an "ld"
# link to the theos one (--ld-path would warn on every compile, and gyp fails
# on any stderr output).
LF_LD=${LEGACYFOX_LD_DIR:-$LF_CACHE/ld}
export CC="clang -target armv7-apple-ios9.0 -isysroot ${LEGACYFOX_SDK:-$HOME/theos/sdks/iPhoneOS6.1.sdk} -B $LF_LD"
export CXX="clang++ -target armv7-apple-ios9.0 -isysroot ${LEGACYFOX_SDK:-$HOME/theos/sdks/iPhoneOS6.1.sdk} -B $LF_LD"
# Headers the 6.1 SDK lacks (sdk-overlay/README.md), searched after the SDK.
LF_OVERLAY="-idirafter $topsrcdir/../../sdk-overlay/include"
# -fobjc-runtime=ios-6.0: no objc_alloc or __NSArray0__ (iOS 12/14 runtime calls).
export CFLAGS="-femulated-tls -fobjc-runtime=ios-6.0 -include $LF_COMPAT/legacyfox_compat.h $LF_OVERLAY"
export CXXFLAGS="-femulated-tls -fobjc-runtime=ios-6.0 -include $LF_COMPAT/legacyfox_compat.h $LF_OVERLAY -nostdinc++ -isystem $LF_CACHE/libcxx-armv7/include/c++/v1"
export HOST_CC=clang
export HOST_CXX=clang++
# sdk-overlay/Frameworks: link stubs for private frameworks (IOSurface).
# libc++ puts operator new/delete in __TEXT,__lcxx_override; ld64 builds
# thumb branch islands only inside __text, and XUL's text is ~80 MB, so the
# section is merged into __text to stay reachable.
export LDFLAGS="-Wl,-rename_section,__TEXT,__lcxx_override,__TEXT,__text -F$topsrcdir/../../sdk-overlay/Frameworks -miphoneos-version-min=$IPHONEOS_DEPLOYMENT_TARGET -nostdlib++ $LF_CACHE/libcxx-armv7/lib/libc++.a $LF_CACHE/libcxx-armv7/lib/libc++abi.a $LF_COMPAT/build/liblegacyfox_compat.a $LF_RT"
export AR=$LF_TC/ar
export RANLIB=$LF_TC/ranlib
export STRIP=$LF_TC/strip
export OTOOL=$LF_TC/otool

# bindgen parses Gecko's headers with libclang: same libc++, compat and
# overlay as the compiler.
export BINDGEN_CFLAGS="-nostdinc++ -isystem $LF_CACHE/libcxx-armv7/include/c++/v1 -include $LF_COMPAT/legacyfox_compat.h $LF_OVERLAY"

# bindgen needs libclang.so; Ubuntu ships only libclang-21.so.1 without the
# dev package, so tools/setup-toolchain.sh links it into the cache.
ac_add_options --with-libclang-path=$LF_CACHE/libclang

# ---- Rust: own target, std built from source --------------------------------
# armv7-apple-ios is gone from rustc; tools/rust/armv7-apple-ios-legacy.json
# is armv7s-apple-ios brought down to the A4, and std comes from -Z build-std,
# as in gecko-w10m. Rust is only ever a staticlib here: rustc cannot link
# for armv7 on Apple targets (tools/rust/README.md).
# The target spec and its std live in the rustc sysroot: tools/rust/install-target.sh
# rustc itself is patched for 32-bit iOS small-struct returns (APCS), see
# tools/rust/build-rustc.sh; cargo is plain nightly.
export RUSTC=$HOME/.rustup/toolchains/lf-nightly/bin/rustc
export CARGO=$HOME/.rustup/toolchains/lf-nightly/bin/cargo
export RUSTFLAGS="$RUSTFLAGS -Cpanic=abort -Zunstable-options"
export RUSTC_BOOTSTRAP=1
ac_add_options --disable-rust-simd

# ---- One process -------------------------------------------------------------
export MOZ_FORCE_DISABLE_E10S=1

# ---- JIT --------------------------------------------------------------------
# Executable memory comes from the dynamic-codesigning entitlement.
ac_add_options --enable-jit

# ---- Trim ---------------------------------------------------------------------
ac_add_options --enable-release
ac_add_options --enable-optimize="-Os"
ac_add_options --disable-debug
ac_add_options --disable-debug-symbols
ac_add_options --disable-tests
ac_add_options --disable-lto
ac_add_options --without-wasm-sandboxed-libraries
ac_add_options --disable-sandbox
ac_add_options --disable-updater
ac_add_options --disable-crashreporter
ac_add_options --disable-printing
ac_add_options --disable-webspeech
ac_add_options --disable-webrtc
ac_add_options --disable-ctypes

# ---- Branding ---------------------------------------------------------------
# Not "Firefox": an unofficial build with its own name and logo.
# mobile/ios has no branding of its own yet; LegacyFox's comes later.
# ac_add_options --with-branding=...
